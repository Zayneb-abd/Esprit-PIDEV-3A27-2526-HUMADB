{% extends 'manager/base_manager.html.twig' %}

{% block title %}Historique des Approbations{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-4">
                <h1 class="fs-3 mb-1">Historique des Approbations</h1>
                <p class="mb-0">Historique des actions de validation des congés et absences</p>
            </div>

            {# Messages flash #}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="card-title mb-0">
                            <i class="ti ti-history me-2"></i>Historique des actions
                        </h5>
                        <a href="{{ path('manager_conges') }}" class="btn btn-secondary btn-sm">
                            <i class="ti ti-arrow-left me-1"></i> Retour aux congés
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Action</th>
                                    <th>Type</th>
                                    <th>Employé</th>
                                    <th>Validé par</th>
                                    <th>Commentaire</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if history is defined and history|length > 0 %}
                                    {% for item in history %}
                                        <tr>
                                            <td>
                                                <small class="text-muted">
                                                    {{ item.createdAt|date('d/m/Y H:i') }}
                                                </small>
                                            </td>
                                            <td>
                                                {% if item.action == 'approve' %}
                                                    <span class="badge bg-success">
                                                        <i class="ti ti-check me-1"></i>Approuvé
                                                    </span>
                                                {% elseif item.action == 'reject' %}
                                                    <span class="badge bg-danger">
                                                        <i class="ti ti-x me-1"></i>Refusé
                                                    </span>
                                                {% else %}
                                                    <span class="badge bg-secondary">
                                                        {{ item.action|capitalize }}
                                                    </span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if item.conge %}
                                                    <span class="badge bg-primary">Congé</span>
                                                {% elseif item.absence %}
                                                    <span class="badge bg-info">Absence</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">-</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if item.conge and item.conge.user %}
                                                    {{ item.conge.user.prenom }} {{ item.conge.user.nom }}
                                                {% elseif item.absence and item.absence.user %}
                                                    {{ item.absence.user.prenom }} {{ item.absence.user.nom }}
                                                {% else %}
                                                    <span class="text-muted">-</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if item.approver %}
                                                    {{ item.approver.prenom }} {{ item.approver.nom }}
                                                {% else %}
                                                    <span class="text-muted">Système</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if item.comment %}
                                                    <small class="text-muted">{{ item.comment }}</small>
                                                {% else %}
                                                    <span class="text-muted">-</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            <i class="ti ti-history-off fs-1 d-block mb-2"></i>
                                            Aucun historique trouvé
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
