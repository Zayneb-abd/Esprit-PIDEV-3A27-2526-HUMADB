{% extends app.user.role == 'MANAGER' ? 'manager/base_manager.html.twig' : 'employ/base_employe.html.twig' %}

{% block title %}Absences par équipe - Rapport{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="fs-3 fw-bold mb-1">
                        <i class="ti ti-users-group me-2 text-primary"></i>Absences par équipe
                    </h1>
                    <p class="text-muted">Rapport détaillé des absences - {{ month }}/{{ year }}</p>
                </div>
                <div class="d-flex gap-2">
                    <form method="get" class="d-flex gap-2">
                        <select name="month" class="form-select" style="width: auto;">
                            {% for m in 1..12 %}
                                <option value="{{ m }}" {{ m == month ? 'selected' : '' }}>
                                    {{ ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'][m-1] }}
                                </option>
                            {% endfor %}
                        </select>
                        <select name="year" class="form-select" style="width: auto;">
                            {% for y in (year-2)..(year+1) %}
                                <option value="{{ y }}" {{ y == year ? 'selected' : '' }}>{{ y }}</option>
                            {% endfor %}
                        </select>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-search"></i>
                        </button>
                    </form>
                    <a href="{{ path('report_dashboard') }}" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left me-1"></i>Retour
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# Summary Cards #}
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="icon-circle bg-primary bg-opacity-10 text-primary" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="ti ti-users fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Employés concernés</h6>
                            <h3 class="mb-0 fw-bold">{{ report|length }}</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="icon-circle bg-warning bg-opacity-10 text-warning" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="ti ti-calendar-x fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Total absences</h6>
                            <h3 class="mb-0 fw-bold">{{ report|reduce((carry, item) => carry + item.total_days, 0) }}</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="icon-circle bg-info bg-opacity-10 text-info" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="ti ti-calculator fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Moyenne par employé</h6>
                            <h3 class="mb-0 fw-bold">
                                {% if report|length > 0 %}
                                    {{ (report|reduce((carry, item) => carry + item.total_days, 0) / report|length)|round(1) }}
                                {% else %}
                                    0
                                {% endif %}
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Detailed Table #}
    <div class="card border-0 shadow-sm" style="border-radius: 15px;">
        <div class="card-header bg-white border-bottom-0 py-3">
            <h5 class="mb-0 fw-bold">
                <i class="ti ti-list me-2"></i>Détail par employé
            </h5>
        </div>
        <div class="card-body">
            {% if report|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Employé</th>
                                <th>Email</th>
                                <th>Périodes d'absence</th>
                                <th>Jours totaux</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in report %}
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle bg-primary text-white me-2" style="width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600;">
                                                {{ item.employee|split(' ')|map(n => n|first)|join('') }}
                                            </div>
                                            <span class="fw-medium">{{ item.employee }}</span>
                                        </div>
                                    </td>
                                    <td class="text-muted">{{ item.email }}</td>
                                    <td>
                                        {% if item.absences|length > 0 %}
                                            {% for absence in item.absences %}
                                                <span class="badge bg-light text-dark border me-1 mb-1">
                                                    <i class="ti ti-calendar me-1"></i>
                                                    {{ absence.start }} → {{ absence.end }}
                                                    <span class="text-primary">({{ absence.days }}j)</span>
                                                </span>
                                            {% endfor %}
                                        {% else %}
                                            <span class="text-muted">Aucune absence ce mois</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge {{ item.total_days > 5 ? 'bg-warning' : 'bg-success' }} fs-6">
                                            {{ item.total_days }} jour{{ item.total_days > 1 ? 's' : '' }}
                                        </span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="ti ti-calendar-check fs-1 text-success mb-3"></i>
                    <h5>Aucune absence enregistrée</h5>
                    <p class="text-muted">Votre équipe n'a pas d'absences ce mois-ci.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
