{% extends app.user.role == 'MANAGER' ? 'manager/base_manager.html.twig' : 'employ/base_employe.html.twig' %}

{% block title %}Tableau de bord - Rapports RH{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="fs-3 fw-bold mb-1">
                <i class="ti ti-chart-bar me-2 text-primary"></i>Tableau de bord RH
            </h1>
            <p class="text-muted">Statistiques et rapports de gestion des congés</p>
        </div>
    </div>

    {# Stats Cards #}
    <div class="row g-4 mb-4">
        {% if stats.team_size is defined %}
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="icon-circle bg-primary bg-opacity-10 text-primary" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="ti ti-users fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Taille de l'équipe</h6>
                            <h3 class="mb-0 fw-bold">{{ stats.team_size }}</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 15px; border-left: 4px solid #ffc107 !important;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="icon-circle bg-warning bg-opacity-10 text-warning" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="ti ti-clock-hour-4 fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Demandes en attente</h6>
                            <h3 class="mb-0 fw-bold">{{ stats.pending_requests|default(0) }}</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 15px; border-left: 4px solid #28a745 !important;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="icon-circle bg-success bg-opacity-10 text-success" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="ti ti-check fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Approuvés ce mois</h6>
                            <h3 class="mb-0 fw-bold">{{ stats.approved_this_month|default(0) }}</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 15px; border-left: 4px solid #6f42c1 !important;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="icon-circle bg-info bg-opacity-10 text-info" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="ti ti-calendar-stats fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Jours de congé (total)</h6>
                            <h3 class="mb-0 fw-bold">{{ stats.total_leave_days_this_month|default(0) }}</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Quick Actions #}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-header bg-white border-bottom-0 py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="ti ti-report me-2"></i>Rapports disponibles
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <a href="{{ path('report_team_absences') }}" class="text-decoration-none">
                                <div class="p-3 border rounded-3 hover-shadow transition-all">
                                    <div class="d-flex align-items-center">
                                        <i class="ti ti-users-group fs-2 text-primary me-3"></i>
                                        <div>
                                            <h6 class="mb-1 fw-bold text-dark">Absences par équipe</h6>
                                            <small class="text-muted">Vue détaillée des absences mensuelles</small>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="{{ path('report_leave_balance') }}" class="text-decoration-none">
                                <div class="p-3 border rounded-3 hover-shadow transition-all">
                                    <div class="d-flex align-items-center">
                                        <i class="ti ti-scale fs-2 text-success me-3"></i>
                                        <div>
                                            <h6 class="mb-1 fw-bold text-dark">Solde de congés</h6>
                                            <small class="text-muted">Balance des congés par employé</small>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="{{ path('report_monthly_summary') }}" class="text-decoration-none">
                                <div class="p-3 border rounded-3 hover-shadow transition-all">
                                    <div class="d-flex align-items-center">
                                        <i class="ti ti-calendar-month fs-2 text-info me-3"></i>
                                        <div>
                                            <h6 class="mb-1 fw-bold text-dark">Résumé mensuel</h6>
                                            <small class="text-muted">Synthèse globale du mois</small>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Export Section #}
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-header bg-white border-bottom-0 py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="ti ti-download me-2"></i>Export de données
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">Téléchargez les rapports au format CSV</p>
                    <a href="{{ path('report_export_csv', {'type': 'absences'}) }}" class="btn btn-outline-primary">
                        <i class="ti ti-file-csv me-2"></i>Exporter les absences
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .hover-shadow:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        transform: translateY(-2px);
        transition: all 0.3s ease;
    }
    .transition-all {
        transition: all 0.3s ease;
    }
</style>
{% endblock %}
