{% extends 'candidat/base_admin.html.twig' %}

{% block title %}Offres disponibles{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="fs-3 mb-1">Offres disponibles</h1>
            <p class="mb-0 text-secondary">Parcourez les offres et postulez directement depuis votre espace candidat.</p>
        </div>
        <a href="{{ path('candidat_product_create') }}" class="btn btn-primary">Postuler a une offre</a>
    </div>

    <div class="row g-4">
        {% for offre in offres %}
            {% set candidature = postulations_par_offre[offre.id] ?? null %}
            <div class="col-xl-6">
                <div class="card h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h5 class="mb-1">{{ offre.titre ?: 'Offre sans titre' }}</h5>
                                <div class="text-secondary">{{ offre.departement ?: 'Departement non renseigne' }}</div>
                            </div>
                            <span class="badge text-bg-light border">{{ offre.typeContrat ?: 'Contrat non renseigne' }}</span>
                        </div>
                        <p class="text-muted flex-grow-1">{{ offre.description ? (offre.description|length > 170 ? offre.description|slice(0, 170) ~ '...' : offre.description) : 'Aucune description disponible.' }}</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div class="small text-secondary">
                                <div>Publication: {{ offre.datePublication ? offre.datePublication|date('d/m/Y') : '-' }}</div>
                                <div>Postes: {{ offre.nombrePostes ?? 0 }}</div>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="{{ path('candidat_offer_show', {id: offre.id}) }}" class="btn btn-sm btn-outline-primary">Details</a>
                                {% if candidature %}
                                    <span class="btn btn-sm btn-light disabled">Deja postule</span>
                                {% else %}
                                    <a href="{{ path('candidat_offer_apply', {id: offre.id}) }}" class="btn btn-sm btn-primary">Postuler</a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-4 text-secondary">Aucune offre disponible pour le moment.</div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
