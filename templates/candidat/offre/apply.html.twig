{% extends 'candidat/base_admin.html.twig' %}

{% block title %}Postuler{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="fs-3 mb-1">Postuler a {{ offre.titre ?: 'cette offre' }}</h1>
            <p class="mb-0 text-secondary">{{ offre.departement ?: 'Departement non renseigne' }} · {{ offre.typeContrat ?: 'Contrat non renseigne' }}</p>
        </div>
        <a href="{{ path('candidat_offer_show', {id: offre.id}) }}" class="btn btn-outline-primary">Retour au detail</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            {{ form_start(form) }}
                <div class="mb-3">{{ form_row(form.cv) }}</div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Envoyer ma candidature</button>
                    <a href="{{ path('candidat_reports') }}" class="btn btn-outline-secondary">Mes candidatures</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
