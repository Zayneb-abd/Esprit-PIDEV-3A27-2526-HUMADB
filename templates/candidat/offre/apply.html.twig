{% extends 'candidat/base_candidat.html.twig' %}

{% block title %}Postuler{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="fs-3 mb-1">Postuler a {{ offre.titre ?: 'cette offre' }}</h1>
            <p class="mb-0 text-secondary">{{ offre.departement ?: 'Departement non renseigne' }} · {{ offre.typeContrat ?: 'Contrat non renseigne' }}</p>
        </div>
        <a href="{{ path('candidat_offer_show', {id: offre.id}) }}" class="btn btn-outline-primary">Retour au detail</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap gap-2 mb-4">
                <span class="badge text-bg-primary">Etape 1: Uploader le CV</span>
                <span class="badge text-bg-light border">Etape 2: Passer le quiz</span>
            </div>
            {{ form_start(form, {attr: {enctype: 'multipart/form-data'}}) }}
                {{ form_errors(form) }}
                <div class="alert alert-info">
                    Deposez votre CV PDF pour cette candidature. Apres validation, vous passerez directement a l etape quiz si l offre contient un quiz.
                </div>
                <div class="row g-3">
                    <div class="col-lg-8">{{ form_row(form.cvFile) }}</div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Continuer vers le quiz</button>
                    <a href="{{ path('candidat_reports') }}" class="btn btn-outline-secondary">Mes candidatures</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
