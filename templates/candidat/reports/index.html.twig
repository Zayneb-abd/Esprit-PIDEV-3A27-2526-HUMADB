{% extends 'candidat/base_admin.html.twig' %}

{% block title %}Mes candidatures{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="fs-3 mb-1">Mes candidatures</h1>
            <p class="mb-0 text-secondary">Suivez l'etat de vos postulations et consultez l'historique de vos demarches.</p>
        </div>
        <a href="{{ path('candidat_inventory') }}" class="btn btn-primary">Consulter les offres</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Offre</th>
                        <th>Departement</th>
                        <th>Date candidature</th>
                        <th>CV</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for candidature in candidatures %}
                        <tr>
                            <td>
                                {% if candidature.offreEmploi %}
                                    <a href="{{ path('candidat_offer_show', {id: candidature.offreEmploi.id}) }}" class="text-decoration-none fw-semibold">
                                        {{ candidature.offreEmploi.titre ?: 'Offre sans titre' }}
                                    </a>
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>{{ candidature.offreEmploi ? candidature.offreEmploi.departement : '-' }}</td>
                            <td>{{ candidature.dateCandidature ? candidature.dateCandidature|date('d/m/Y') : '-' }}</td>
                            <td>{{ candidature.cv ?: '-' }}</td>
                            <td>
                                <span class="badge text-bg-{{ candidature.statut == 'Acceptee' ? 'success' : (candidature.statut == 'Refusee' ? 'danger' : (candidature.statut == 'En cours' ? 'primary' : 'warning')) }}">
                                    {{ candidature.statut ?: 'En attente' }}
                                </span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-4 text-secondary">Vous n'avez encore aucune candidature.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
