{% extends 'base.html.twig' %}

{% block title %}À propos de <span class="huma-brand">HUMA</span>{% endblock %}

{% block body %}
<!-- Page Header -->
<section class="page-header">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h1 class="page-title">À propos de <span class="huma-brand">HUMA</span></h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-center">
                        <li class="breadcrumb-item"><a href="{{ path('client_home') }}">Accueil</a></li>
                        <li class="breadcrumb-item active" aria-current="page">À propos</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>

<!-- About HUMA Section -->
<section class="agency-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <p class="agency-subtitle">Qui sommes-nous</p>
                <h2 class="section-title section-title-left">Votre partenaire RH<br>de confiance</h2>
                <div class="approach-card mt-4">
                    <p class="mb-4">
                        <strong><span class="huma-brand">HUMA</span></strong> est un cabinet de conseil en ressources humaines spécialisé dans l'accompagnement des entreprises de toutes tailles. Notre mission est de vous aider à valoriser votre capital humain et à optimiser vos pratiques RH.
                    </p>
                    <p class="mb-4">
                        Avec plus de 10 ans d'expérience dans le domaine des ressources humaines, notre équipe d'experts met son savoir-faire au service de votre développement. Que vous soyez une PME ou un grand groupe, nous adaptons nos solutions à vos besoins spécifiques.
                    </p>
                    <div class="row mt-4">
                        <div class="col-6">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-check-circle me-2" style="color: var(--accent-cyan);"></i>
                                <span>Expertise reconnue</span>
                            </div>
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-check-circle me-2" style="color: var(--accent-cyan);"></i>
                                <span>Accompagnement sur mesure</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-check-circle me-2" style="color: var(--accent-cyan);"></i>
                                <span>Équipe qualifiée</span>
                            </div>
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-check-circle me-2" style="color: var(--accent-cyan);"></i>
                                <span>Approche pragmatique</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <div class="approach-image">
                    <img src="{{ asset('client/img/about.jpg') }}" alt="Équipe HUMA" class="img-fluid">
                    <div class="approach-image-small">
                        <img src="{{ asset('client/img/carousel-1.jpg') }}" alt="Collaboration" class="img-fluid">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Our Values Section -->
<section class="approach-section">
    <div class="container">
        <div class="text-center mb-5">
            <p class="agency-subtitle">Nos valeurs</p>
            <h2 class="section-title">Ce qui nous anime</h2>
        </div>
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="approach-card text-center h-100">
                    <div class="mb-3">
                        <i class="fas fa-heart" style="font-size: 2.5rem; color: var(--primary-teal);"></i>
                    </div>
                    <h4>Passion</h4>
                    <p class="mb-0">Nous sommes passionnés par les ressources humaines et l'accompagnement des entreprises vers l'excellence.</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="approach-card text-center h-100">
                    <div class="mb-3">
                        <i class="fas fa-handshake" style="font-size: 2.5rem; color: var(--primary-teal);"></i>
                    </div>
                    <h4>Confiance</h4>
                    <p class="mb-0">Nous construisons des relations de confiance durables avec nos clients basées sur la transparence.</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="approach-card text-center h-100">
                    <div class="mb-3">
                        <i class="fas fa-lightbulb" style="font-size: 2.5rem; color: var(--primary-teal);"></i>
                    </div>
                    <h4>Innovation</h4>
                    <p class="mb-0">Nous proposons des solutions innovantes et adaptées aux évolutions du monde du travail.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="opportunities-section">
    <div class="container">
        <div class="text-center mb-5">
            <p class="agency-subtitle">Notre équipe</p>
            <h2 class="section-title">Les experts <span class="huma-brand">HUMA</span></h2>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="team-card">
                    <div class="team-image">
                        <img src="{{ asset('client/img/team-1.jpg') }}" alt="Directrice RH">
                    </div>
                    <div class="team-content">
                        <h4>Sophie Martin</h4>
                        <p class="text-muted">Directrice des Ressources Humaines</p>
                        <p class="small mb-0">15 ans d'expérience en conseil RH et management des talents.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="team-card">
                    <div class="team-image">
                        <img src="{{ asset('client/img/team-2.jpg') }}" alt="Consultant">
                    </div>
                    <div class="team-content">
                        <h4>Thomas Dubois</h4>
                        <p class="text-muted">Consultant Senior</p>
                        <p class="small mb-0">Expert en recrutement et gestion des carrières.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="team-card">
                    <div class="team-image">
                        <img src="{{ asset('client/img/team-3.jpg') }}" alt="Formatrice">
                    </div>
                    <div class="team-content">
                        <h4>Marie Leroy</h4>
                        <p class="text-muted">Responsable Formation</p>
                        <p class="small mb-0">Spécialiste en développement des compétences et plans de formation.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="needs-section">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h2 class="mb-4" style="color: white;">Prêt à transformer votre gestion RH ?</h2>
                <p class="text-white-50 mb-4">Contactez <span class="huma-brand">HUMA</span> dès aujourd'hui pour découvrir comment nous pouvons vous accompagner.</p>
                <a href="{{ path('contact_index') }}" class="btn btn-primary" style="background: var(--accent-cyan); border: none; padding: 0.8rem 2rem; border-radius: 30px; color: white; font-weight: 600;">Nous contacter</a>
            </div>
        </div>
    </div>
</section>
{% endblock %}