{% extends 'base.html.twig' %}

{% block title %}Contactez <span class="huma-brand">HUMA</span>{% endblock %}

{% block body %}
<!-- Page Header -->
<section class="page-header">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h1 class="page-title">Contactez-nous</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-center">
                        <li class="breadcrumb-item"><a href="{{ path('client_home') }}">Accueil</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Contact</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>

<!-- Contact Info Section -->
<section class="agency-section">
    <div class="container">
        <div class="text-center mb-5">
            <p class="agency-subtitle">Nous sommes là pour vous</p>
            <h2 class="section-title">Restons en contact</h2>
            <p class="text-muted">Une question ? Un projet RH ? N'hésitez pas à nous contacter.</p>
        </div>
        <div class="row g-4 mb-5">
            <div class="col-lg-4">
                <div class="approach-card text-center h-100">
                    <div class="mb-3">
                        <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background: linear-gradient(135deg, var(--primary-teal) 0%, var(--accent-cyan) 100%);">
                            <i class="bi bi-telephone-fill text-white fs-4"></i>
                        </div>
                    </div>
                    <h4 class="mb-2" style="color: var(--primary-teal);">Téléphone</h4>
                    <p class="mb-1 text-muted">Appelez-nous pour discuter de vos besoins</p>
                    <a href="tel:+21671000000" class="fw-bold" style="color: var(--primary-teal);">+216 71 000 000</a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="approach-card text-center h-100">
                    <div class="mb-3">
                        <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background: linear-gradient(135deg, var(--primary-teal) 0%, var(--accent-cyan) 100%);">
                            <i class="bi bi-envelope-fill text-white fs-4"></i>
                        </div>
                    </div>
                    <h4 class="mb-2" style="color: var(--primary-teal);">Email</h4>
                    <p class="mb-1 text-muted">Envoyez-nous un message</p>
                    <a href="mailto:contact@huma.tn" class="fw-bold" style="color: var(--primary-teal);">contact@huma.tn</a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="approach-card text-center h-100">
                    <div class="mb-3">
                        <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background: linear-gradient(135deg, var(--primary-teal) 0%, var(--accent-cyan) 100%);">
                            <i class="bi bi-geo-alt-fill text-white fs-4"></i>
                        </div>
                    </div>
                    <h4 class="mb-2" style="color: var(--primary-teal);">Adresse</h4>
                    <p class="mb-1 text-muted">Venez nous rencontrer</p>
                    <span class="fw-bold" style="color: var(--primary-teal);">Tunis, Tunisie</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Form Section -->
<section class="approach-section" style="background: var(--bg-light);">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <p class="agency-subtitle">Envoyez-nous un message</p>
                <h2 class="section-title section-title-left">Discutons de votre projet RH</h2>
                <p class="text-muted mb-4">Remplissez le formulaire ci-contre et notre équipe vous recontactera dans les plus brefs délais pour étudier vos besoins en ressources humaines.</p>
                
                <div class="mt-4">
                    <h5 class="mb-3" style="color: var(--primary-teal);">Nos horaires d'ouverture</h5>
                    <p class="mb-2"><i class="bi bi-clock me-2" style="color: var(--accent-cyan);"></i>Lundi - Vendredi : 8h30 - 17h30</p>
                    <p class="mb-2"><i class="bi bi-clock me-2" style="color: var(--accent-cyan);"></i>Samedi : 8h30 - 12h00</p>
                    <p class="text-muted"><i class="bi bi-clock me-2" style="color: var(--accent-cyan);"></i>Dimanche : Fermé</p>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="approach-card">
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Nom</label>
                                <input type="text" class="form-control" placeholder="Votre nom" style="height: 50px; border-radius: 10px; border: 2px solid #e9ecef;">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Prénom</label>
                                <input type="text" class="form-control" placeholder="Votre prénom" style="height: 50px; border-radius: 10px; border: 2px solid #e9ecef;">
                            </div>
                            <div class="col-12">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" placeholder="votre@email.com" style="height: 50px; border-radius: 10px; border: 2px solid #e9ecef;">
                            </div>
                            <div class="col-12">
                                <label class="form-label">Entreprise</label>
                                <input type="text" class="form-control" placeholder="Nom de votre entreprise" style="height: 50px; border-radius: 10px; border: 2px solid #e9ecef;">
                            </div>
                            <div class="col-12">
                                <label class="form-label">Sujet</label>
                                <select class="form-select" style="height: 50px; border-radius: 10px; border: 2px solid #e9ecef;">
                                    <option selected>Sélectionnez un sujet</option>
                                    <option>Recrutement</option>
                                    <option>Formation</option>
                                    <option>Conseil RH</option>
                                    <option>Évaluation des risques</option>
                                    <option>Autre</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Message</label>
                                <textarea class="form-control" rows="4" placeholder="Décrivez votre besoin..." style="border-radius: 10px; border: 2px solid #e9ecef;"></textarea>
                            </div>
                            <div class="col-12">
                                <button class="btn btn-primary w-100" type="submit" style="background: linear-gradient(135deg, var(--primary-teal) 0%, var(--accent-cyan) 100%); border: none; padding: 0.8rem; font-weight: 600; border-radius: 30px;">Envoyer le message</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Map Section -->
<section class="needs-section py-5">
    <div class="container-fluid px-0">
        <div class="text-center mb-4">
            <p class="agency-subtitle" style="color: var(--accent-cyan);">Notre localisation</p>
            <h2 class="section-title" style="color: white;">Où nous trouver</h2>
        </div>
        <div class="row g-0">
            <div class="col-12">
                <iframe class="w-100"
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d25584.16575469355!2d10.1807!3d36.8065!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12fd337f5e7ef543%3A0xd671924fb517be07!2sTunis%2C%20Tunisia!5e0!3m2!1sen!2s!4v1699999999999!5m2!1sen!2s"
                    frameborder="0" style="min-height: 400px; border:0; filter: grayscale(30%);" allowfullscreen="" aria-hidden="false"
                    tabindex="0"></iframe>
            </div>
        </div>
    </div>
</section>
{% endblock %}
