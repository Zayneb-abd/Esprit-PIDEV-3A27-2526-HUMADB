{% extends 'base.html.twig' %}

{% block title %}<span class="huma-brand">HUMA</span> - Agence de Gestion des Ressources Humaines{% endblock %}

{% block body %}
<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 hero-content">
                <h1 class="hero-title">Évaluation des risques professionnels<br>Et des risques psychosociaux</h1>
                <p class="hero-subtitle"><span class="huma-brand">HUMA</span> accompagne votre entreprise dans la gestion optimale de vos ressources humaines et la prévention des risques au travail.</p>
                <a href="#agency" class="btn btn-hero">En savoir plus</a>
            </div>
            <div class="col-lg-6 hero-image d-none d-lg-block">
                <img src="{{ asset('client/img/carousel-1.jpg') }}" alt="Équipe HUMA" class="img-fluid">
            </div>
        </div>
    </div>
</section>

<!-- Specialized Agency Section -->
<section id="agency" class="agency-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <p class="agency-subtitle">Votre partenaire RH</p>
                <h2 class="section-title">L'agence spécialisée<br>en <span class="huma-brand">Ressources Humaines</span></h2>
                <p class="text-muted mt-4" style="font-size: 1.1rem;">
                    <strong>Valoriser votre capital humain</strong>
                </p>
                <p class="text-muted">
                    Vous recherchez un professionnel des ressources humaines ? Un directeur des ressources humaines expert pour vous assister dans votre développement ? Notre cabinet de recrutement <span class="huma-brand">HUMA</span> répond à vos attentes !
                </p>
                <p class="text-muted">
                    Notre équipe de staffing management répond à vos demandes avec expertise et réactivité.
                </p>
                <a href="{{ path('client_about') }}" class="btn btn-primary mt-4" style="background: var(--primary-teal); border: none; padding: 0.8rem 2rem; border-radius: 30px;">Découvrir <span class="huma-brand">HUMA</span> Management</a>
            </div>
        </div>
    </div>
</section>

<!-- Approach Section -->
<section class="approach-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <p class="agency-subtitle">Notre méthodologie</p>
                <h2 class="section-title section-title-left">Notre approche</h2>
                <div class="approach-card mt-4">
                    <p class="mb-4">
                        Parce que nous avons à cœur d'être des interlocuteurs privilégiés pour la performance de votre entreprise, nous avons développé une expertise à la fois globale et personnalisée.
                    </p>
                    <p class="mb-4">
                        Notre expertise couvre l'ensemble des domaines RH : recrutement, formation, gestion des carrières, prévention des risques psychosociaux et optimisation de la masse salariale.
                    </p>
                    <p class="mb-0">
                        Notre approche pragmatique et opérationnelle nous permet d'optimiser et sécuriser vos pratiques RH tout en respectant la culture de votre entreprise.
                    </p>
                    <a href="{{ path('contact_index') }}" class="btn btn-primary mt-4" style="background: var(--accent-cyan); border: none; padding: 0.8rem 2rem; border-radius: 30px; color: white;">Nous contacter</a>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <div class="approach-image">
                    <img src="{{ asset('client/img/about.jpg') }}" alt="Notre équipe" class="img-fluid">
                    <div class="approach-image-small">
                        <img src="{{ asset('client/img/team-1.jpg') }}" alt="Collaboration" class="img-fluid">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- RH Needs Section -->
<section class="needs-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <p class="agency-subtitle" style="color: var(--accent-cyan);">Nos expertises</p>
                <h2 class="section-title section-title-left">Vos Besoins RH</h2>
                <p class="text-white-50 mb-5">Des solutions adaptées à chaque étape de la gestion de vos ressources humaines</p>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6">
                <div class="need-card">
                    <h4>Piloter la fonction RH ou la mettre en place</h4>
                    <p class="mb-0">Mise en temps partagé et management RH sur mesure pour structurer votre politique RH et accompagner vos managers.</p>
                    <a href="#" class="text-white-50 small mt-2 d-inline-block" style="text-decoration: none;">En savoir plus →</a>
                </div>
                <div class="need-card">
                    <h4>Être conseillé ponctuellement sur un sujet RH</h4>
                    <p class="mb-0">Conseil à l'Expertise RH pour résoudre vos problématiques spécifiques avec des recommandations personnalisées.</p>
                    <a href="#" class="text-white-50 small mt-2 d-inline-block" style="text-decoration: none;">En savoir plus →</a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="need-card">
                    <h4>Sécuriser et optimiser mes pratiques RH</h4>
                    <p class="mb-0">Audit et conformité pour sécuriser juridiquement vos processus et optimiser votre politique de rémunération.</p>
                    <a href="#" class="text-white-50 small mt-2 d-inline-block" style="text-decoration: none;">En savoir plus →</a>
                </div>
                <div class="need-card">
                    <h4>Garantir la santé et la sécurité de mes collaborateurs</h4>
                    <p class="mb-0">Évaluation des risques professionnels et risques psychosociaux pour un environnement de travail sain.</p>
                    <a href="#" class="text-white-50 small mt-2 d-inline-block" style="text-decoration: none;">En savoir plus →</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Opportunities Section -->
<section class="opportunities-section">
    <div class="container">
        <div class="text-center mb-5">
            <p class="agency-subtitle">Carrières</p>
            <h2 class="section-title">Opportunités</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="opportunity-card">
                    <img src="{{ asset('client/img/carousel-2.jpg') }}" alt="Offres d'emploi">
                    <div class="opportunity-content">
                        <h3>Offres d'emploi</h3>
                        <p class="mb-4">Découvrez nos postes disponibles et rejoignez <span class="huma-brand">HUMA</span></p>
                        <a href="{{ path('client_jobs') }}" class="btn btn-light" style="border-radius: 30px; padding: 0.8rem 2rem;">Voir les offres</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="opportunity-card yellow">
                    <img src="{{ asset('client/img/feature.jpg') }}" alt="Nous rejoindre">
                    <div class="opportunity-content">
                        <h3>Nous rejoindre</h3>
                        <p class="mb-4">Vous souhaitez intégrer notre équipe RH ?</p>
                        <a href="{{ path('contact_index') }}" class="btn btn-light" style="border-radius: 30px; padding: 0.8rem 2rem;">Postuler</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
