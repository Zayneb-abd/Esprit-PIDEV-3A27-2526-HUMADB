{% extends 'base.html.twig' %}

{% block title %}Offres d'emploi HUMA{% endblock %}

{% block body %}
<div class="container-fluid bg-primary py-5 bg-header">
    <div class="row py-5">
        <div class="col-12 pt-lg-5 mt-lg-5 text-center">
            <h1 class="display-4 text-white animated zoomIn">Nos offres d'emploi</h1>
            <a href="{{ path('client_home') }}" class="h5 text-white">Accueil</a>
            <i class="far fa-circle text-white px-2"></i>
            <span class="h5 text-white">Jobs</span>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        {% for offre in offres %}
            <div class="col-lg-6">
                <div class="bg-light rounded p-4 h-100 shadow-sm">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h4 class="mb-1">{{ offre.titre ?: 'Offre sans titre' }}</h4>
                            <p class="mb-0 text-muted">{{ offre.departement ?: 'Departement non renseigne' }}</p>
                        </div>
                        <span class="badge bg-white text-dark border">{{ offre.typeContrat ?: 'Contrat non renseigne' }}</span>
                    </div>

                    <p class="text-muted mb-3">
                        {{ offre.description ? (offre.description|length > 190 ? offre.description|slice(0, 190) ~ '...' : offre.description) : 'Aucune description disponible.' }}
                    </p>

                    <div class="small text-muted mb-3">
                        Publiee le {{ offre.datePublication ? offre.datePublication|date('d/m/Y') : '-' }} ·
                        {{ offre.nombrePostes ?? 0 }} poste(s)
                    </div>

                    <a href="{{ path('client_job_show', {id: offre.id}) }}" class="btn btn-primary">Voir l'offre</a>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="bg-light rounded p-4 text-muted">Aucune offre n'est disponible pour le moment.</div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
