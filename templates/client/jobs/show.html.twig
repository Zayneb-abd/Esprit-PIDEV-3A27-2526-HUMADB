{% extends 'base.html.twig' %}

{% block title %}{{ offre.titre ?: 'Offre HUMA' }}{% endblock %}

{% block body %}
<div class="container-fluid bg-primary py-5 bg-header">
    <div class="row py-5">
        <div class="col-12 pt-lg-5 mt-lg-5 text-center">
            <h1 class="display-5 text-white animated zoomIn">{{ offre.titre ?: 'Offre sans titre' }}</h1>
            <a href="{{ path('client_jobs') }}" class="h5 text-white">Nos offres</a>
            <i class="far fa-circle text-white px-2"></i>
            <span class="h5 text-white">{{ offre.departement ?: 'HUMA' }}</span>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="bg-light rounded p-4 shadow-sm h-100">
                <h3 class="mb-3">Description du poste</h3>
                <p class="text-muted mb-0">{{ offre.description ?: 'Aucune description disponible pour cette offre.' }}</p>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="bg-light rounded p-4 shadow-sm">
                <h4 class="mb-3">Informations</h4>
                <p class="mb-2"><strong>Departement:</strong> {{ offre.departement ?: '-' }}</p>
                <p class="mb-2"><strong>Contrat:</strong> {{ offre.typeContrat ?: '-' }}</p>
                <p class="mb-2"><strong>Publication:</strong> {{ offre.datePublication ? offre.datePublication|date('d/m/Y') : '-' }}</p>
                <p class="mb-4"><strong>Postes ouverts:</strong> {{ offre.nombrePostes ?? 0 }}</p>
                <a href="{{ path('app_login') }}" class="btn btn-primary w-100">Se connecter pour postuler</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
