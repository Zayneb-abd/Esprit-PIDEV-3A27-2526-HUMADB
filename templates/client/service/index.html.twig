{% extends 'base.html.twig' %}

{% block title %}Nos Solutions RH - <span class="huma-brand">HUMA</span>{% endblock %}

{% block body %}
<!-- Page Header -->
<section class="page-header">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h1 class="page-title">Nos Solutions <span class="huma-brand">RH</span></h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-center">
                        <li class="breadcrumb-item"><a href="{{ path('client_home') }}">Accueil</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Nos solutions RH</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>

<!-- Services Overview -->
<section class="agency-section">
    <div class="container">
        <div class="text-center mb-5">
            <p class="agency-subtitle">Expertise RH</p>
            <h2 class="section-title">Des solutions complètes<br>pour votre entreprise</h2>
            <p class="text-muted">Découvrez comment <span class="huma-brand">HUMA</span> peut vous accompagner dans tous vos projets ressources humaines</p>
        </div>
    </div>
</section>

<!-- Gestion des Talents -->
<section class="approach-section" id="talents">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 order-lg-2">
                <p class="agency-subtitle">Gestion des talents</p>
                <h2 class="section-title section-title-left">Valorisez votre capital humain</h2>
                <div class="approach-card mt-4">
                    <p class="mb-4">
                        Notre expertise en <strong>gestion des talents</strong> vous accompagne dans l'optimisation du potentiel de vos collaborateurs. Nous mettons en place des stratégies sur mesure pour attirer, développer et fidéliser vos talents.
                    </p>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill me-3 mt-1" style="color: var(--accent-cyan);"></i>
                            <span>Cartographie des compétences et plans de succession</span>
                        </li>
                        <li class="mb-3 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill me-3 mt-1" style="color: var(--accent-cyan);"></i>
                            <span>Management des talents et des potentiels</span>
                        </li>
                        <li class="mb-3 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill me-3 mt-1" style="color: var(--accent-cyan);"></i>
                            <span>Programmes de développement individuel</span>
                        </li>
                        <li class="mb-0 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill me-3 mt-1" style="color: var(--accent-cyan);"></i>
                            <span>Évaluation des performances et entretiens annuels</span>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-6 order-lg-1 d-none d-lg-block">
                <div class="approach-image">
                    <img src="{{ asset('client/img/feature.jpg') }}" alt="Gestion des talents" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Recrutement -->
<section class="agency-section" id="recrutement">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <p class="agency-subtitle">Recrutement</p>
                <h2 class="section-title section-title-left">Trouvez les meilleurs profils</h2>
                <div class="approach-card mt-4">
                    <p class="mb-4">
                        Notre service de <strong>recrutement</strong> identifie et sélectionne les talents qui correspondent parfaitement à votre culture d'entreprise et à vos besoins métiers. Nous simplifions votre processus de recrutement tout en garantissant la qualité des candidats.
                    </p>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill me-3 mt-1" style="color: var(--accent-cyan);"></i>
                            <span>Définition des profils et sourcing ciblé</span>
                        </li>
                        <li class="mb-3 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill me-3 mt-1" style="color: var(--accent-cyan);"></i>
                            <span>Présélection et évaluation des candidats</span>
                        </li>
                        <li class="mb-3 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill me-3 mt-1" style="color: var(--accent-cyan);"></i>
                            <span>Accompagnement des managers en entretien</span>
                        </li>
                        <li class="mb-0 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill me-3 mt-1" style="color: var(--accent-cyan);"></i>
                            <span>Intégration et suivi post-embauche</span>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <div class="approach-image">
                    <img src="{{ asset('client/img/carousel-1.jpg') }}" alt="Recrutement" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Formation -->
<section class="approach-section" id="formation">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 order-lg-2">
                <p class="agency-subtitle">Formation</p>
                <h2 class="section-title section-title-left">Développez vos compétences</h2>
                <div class="approach-card mt-4">
                    <p class="mb-4">
                        Nos programmes de <strong>formation</strong> sont conçus pour accompagner le développement des compétences de vos collaborateurs. Du plan de formation annuel aux formations sur mesure, nous vous aidons à construire une politique de formation efficace.
                    </p>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill me-3 mt-1" style="color: var(--accent-cyan);"></i>
                            <span>Évaluation des besoins en formation (Bilan social)</span>
                        </li>
                        <li class="mb-3 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill me-3 mt-1" style="color: var(--accent-cyan);"></i>
                            <span>Plan de formation annuel et budget formation</span>
                        </li>
                        <li class="mb-3 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill me-3 mt-1" style="color: var(--accent-cyan);"></i>
                            <span>Formations managériales et techniques</span>
                        </li>
                        <li class="mb-0 d-flex align-items-start">
                            <i class="bi bi-check-circle-fill me-3 mt-1" style="color: var(--accent-cyan);"></i>
                            <span>Évaluation de l'efficacité des formations</span>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-6 order-lg-1 d-none d-lg-block">
                <div class="approach-image">
                    <img src="{{ asset('client/img/carousel-2.jpg') }}" alt="Formation" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="needs-section">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h2 class="mb-4" style="color: white;">Besoin d'une solution RH sur mesure ?</h2>
                <p class="text-white-50 mb-4"><span class="huma-brand">HUMA</span> vous accompagne dans la mise en place de solutions adaptées à vos besoins spécifiques.</p>
                <a href="{{ path('contact_index') }}" class="btn btn-primary" style="background: var(--accent-cyan); border: none; padding: 0.8rem 2rem; border-radius: 30px; color: white; font-weight: 600;">Demandez un devis</a>
            </div>
        </div>
    </div>
</section>
{% endblock %}