<div class="publication-translation-widget mt-3" data-publication-id="{{ publication.id }}">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-gradient py-2 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <i class="fas fa-language me-2 text-primary"></i>
                <span class="fw-semibold text-dark">Traduction</span>
            </div>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-primary translate-btn" data-locale="en" title="Anglais">
                    <i class="fas fa-flag-usa"></i> EN
                </button>
                <button type="button" class="btn btn-outline-primary translate-btn" data-locale="ar" title="Arabe">
                    <i class="fas fa-moon"></i> AR
                </button>
                <button type="button" class="btn btn-outline-primary translate-btn" data-locale="ru" title="Russe">
                    <i class="fas fa-star"></i> RU
                </button>
                <button type="button" class="btn btn-outline-secondary translate-btn" data-locale="fr" title="Français">
                    <i class="fas fa-flag"></i> FR
                </button>
            </div>
        </div>
        <div class="translation-result card-body p-3 d-none">
            <!-- Translation content will be inserted here -->
        </div>
    </div>
</div>

<script>
if (!window.publicationTranslationWidgetInitialized) {
    window.publicationTranslationWidgetInitialized = true;

    document.addEventListener('click', function(event) {
        const button = event.target.closest('.translate-btn');
        if (!button) {
            return;
        }

        const widget = button.closest('.publication-translation-widget');
        if (!widget) {
            return;
        }

        const publicationId = widget.dataset.publicationId;
        const locale = button.dataset.locale;
        const resultBox = widget.querySelector('.translation-result');

        if (!resultBox) {
            return;
        }

        resultBox.classList.remove('d-none');
        resultBox.innerHTML = `
            <div class="d-flex align-items-center">
                <div class="spinner-border spinner-border-sm me-2 text-primary" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
                <span class="text-muted">Traduction en cours...</span>
            </div>
        `;

        fetch(`/api/publications/${publicationId}/translate/${locale}`, {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (!data.success) {
                resultBox.innerHTML = `
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <div>
                            <strong>Erreur de traduction</strong><br>
                            <small class="text-muted">${escapeHtml(data.error || 'Erreur inconnue')}</small>
                        </div>
                    </div>
                `;
                return;
            }

            resultBox.innerHTML = `
                <div class="translation-content">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        <span class="badge bg-primary-subtle text-primary-emphasis">
                            <i class="fas fa-globe me-1"></i>
                            ${locale.toUpperCase()}
                        </span>
                        <small class="text-muted ms-auto">Traduit avec succès</small>
                    </div>
                    <div class="translation-text p-3 bg-light rounded border-start border-4 border-primary">
                        <div style="white-space: pre-wrap; line-height: 1.6;">${escapeHtml(data.translated_content || '')}</div>
                    </div>
                    <div class="mt-2">
                        <button class="btn btn-sm btn-outline-secondary" onclick="copyTranslation(this)">
                            <i class="fas fa-copy me-1"></i> Copier
                        </button>
                        <button class="btn btn-sm btn-outline-primary ms-1" onclick="speakTranslation(this, '${locale}')">
                            <i class="fas fa-volume-up me-1"></i> Écouter
                        </button>
                    </div>
                </div>
            `;
        })
        .catch(() => {
            resultBox.innerHTML = `
                <div class="alert alert-warning d-flex align-items-center" role="alert">
                    <i class="fas fa-wifi me-2"></i>
                    <div>
                        <strong>Erreur de connexion</strong><br>
                        <small class="text-muted">Vérifiez votre connexion internet et réessayez</small>
                    </div>
                </div>
            `;
        });
    });

    function escapeHtml(text) {
        return text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    // Additional functions for enhanced UX
    function copyTranslation(button) {
        const translationText = button.closest('.translation-content').querySelector('.translation-text div').textContent;
        navigator.clipboard.writeText(translationText).then(() => {
            const originalText = button.innerHTML;
            button.innerHTML = '<i class="fas fa-check me-1"></i> Copié!';
            button.classList.remove('btn-outline-secondary');
            button.classList.add('btn-success');
            
            setTimeout(() => {
                button.innerHTML = originalText;
                button.classList.remove('btn-success');
                button.classList.add('btn-outline-secondary');
            }, 2000);
        });
    }

    function speakTranslation(button, locale) {
        const translationText = button.closest('.translation-content').querySelector('.translation-text div').textContent;
        
        if ('speechSynthesis' in window) {
            const utterance = new SpeechSynthesisUtterance(translationText);
            
            // Set language based on locale
            const langMap = {
                'en': 'en-US',
                'ar': 'ar-SA',
                'ru': 'ru-RU',
                'fr': 'fr-FR'
            };
            utterance.lang = langMap[locale] || 'en-US';
            
            const originalText = button.innerHTML;
            button.innerHTML = '<i class="fas fa-volume-up me-1"></i> Lecture...';
            button.disabled = true;
            
            utterance.onend = () => {
                button.innerHTML = originalText;
                button.disabled = false;
            };
            
            utterance.onerror = () => {
                button.innerHTML = '<i class="fas fa-exclamation me-1"></i> Erreur';
                setTimeout(() => {
                    button.innerHTML = originalText;
                    button.disabled = false;
                }, 2000);
            };
            
            window.speechSynthesis.speak(utterance);
        } else {
            button.innerHTML = '<i class="fas fa-exclamation me-1"></i> Non supporté';
            setTimeout(() => {
                button.innerHTML = originalText;
            }, 2000);
        }
    }
}
</script>
