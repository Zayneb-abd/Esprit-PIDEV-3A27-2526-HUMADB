{% extends 'base_user.html.twig' %}

{% block title %}HumaBot Chat History{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/chatbot.css') }}">
    <style>
        .history-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            font-family: 'Rajdhani', sans-serif;
        }
        
        .history-header {
            text-align: center;
            margin-bottom: 40px;
            color: #00f5ff;
        }
        
        .history-header h1 {
            font-family: 'Orbitron', monospace;
            font-size: 2.5rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 10px;
            text-shadow: 0 0 20px rgba(0,245,255,0.5);
        }
        
        .history-header p {
            font-size: 1.1rem;
            opacity: 0.8;
        }
        
        .sessions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }
        
        .session-card {
            background: rgba(10, 10, 15, 0.9);
            border: 1px solid rgba(0,245,255,0.3);
            border-radius: 16px;
            padding: 20px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        
        .session-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #00f5ff, #bf00ff, #ff006e);
            transform: translateX(-100%);
            transition: transform 0.3s;
        }
        
        .session-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,245,255,0.3);
            border-color: #00f5ff;
        }
        
        .session-card:hover::before {
            transform: translateX(0);
        }
        
        .session-date {
            color: #00f5ff;
            font-family: 'Orbitron', monospace;
            font-weight: 600;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }
        
        .session-preview {
            color: #e0e0ff;
            font-size: 1rem;
            line-height: 1.4;
            margin-bottom: 10px;
            height: 40px;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }
        
        .session-stats {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: rgba(255,255,255,0.6);
            font-size: 0.85rem;
        }
        
        .message-count {
            background: rgba(0,245,255,0.1);
            border: 1px solid rgba(0,245,255,0.3);
            border-radius: 12px;
            padding: 2px 8px;
            color: #00f5ff;
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: rgba(255,255,255,0.6);
        }
        
        .empty-state h2 {
            font-family: 'Orbitron', monospace;
            color: #00f5ff;
            margin-bottom: 20px;
        }
        
        .empty-state p {
            font-size: 1.1rem;
            margin-bottom: 30px;
        }
        
        .start-chat-btn {
            background: linear-gradient(135deg, #00f5ff, #bf00ff);
            border: none;
            color: white;
            padding: 12px 30px;
            border-radius: 25px;
            font-family: 'Orbitron', monospace;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 0 20px rgba(0,245,255,0.3);
        }
        
        .start-chat-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 30px rgba(0,245,255,0.5);
        }
        
        .back-btn {
            position: fixed;
            top: 20px;
            left: 20px;
            background: rgba(0,245,255,0.1);
            border: 1px solid rgba(0,245,255,0.4);
            color: #00f5ff;
            padding: 8px 16px;
            border-radius: 20px;
            text-decoration: none;
            font-family: 'Rajdhani', sans-serif;
            font-weight: 500;
            transition: all 0.2s;
            z-index: 1000;
        }
        
        .back-btn:hover {
            background: rgba(0,245,255,0.2);
            box-shadow: 0 0 10px rgba(0,245,255,0.5);
        }
        
        @media (max-width: 768px) {
            .sessions-grid {
                grid-template-columns: 1fr;
            }
            
            .history-header h1 {
                font-size: 2rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="history-container">
        <a href="{{ path('app_user_index') }}" class="back-btn">â Back to Dashboard</a>
        
        <div class="history-header">
            <h1>HumaBot History</h1>
            <p>Your conversation history with the AI support assistant</p>
        </div>
        
        {% if sessions|length > 0 %}
            <div class="sessions-grid">
                {% for session in sessions %}
                    <a href="{{ path('chatbot_session_detail', {'sessionId': session.sessionId}) }}" 
                       class="session-card"
                       style="text-decoration: none;">
                        <div class="session-date">
                            {{ session.firstMessageAt|date('M j, Y - g:i A') }}
                        </div>
                        <div class="session-preview">
                            {{ session.firstMessage|slice(0, 100) }}{% if session.firstMessage|length > 100 %}...{% endif %}
                        </div>
                        <div class="session-stats">
                            <span>{{ session.firstMessageAt|ago }}</span>
                            <span class="message-count">{{ session.messageCount }} messages</span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">
                <h2>No Chat History Yet</h2>
                <p>You haven't had any conversations with HumaBot yet.</p>
                <p>Click the chatbot widget to start your first conversation!</p>
                <button class="start-chat-btn" onclick="window.HumaChatbot?.open()">
                    Start Chatting
                </button>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Auto-open chatbot if requested from empty state
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('open_chat') === 'true' && window.HumaChatbot) {
                setTimeout(() => {
                    window.HumaChatbot.open();
                }, 500);
            }
        });
    </script>
{% endblock %}
