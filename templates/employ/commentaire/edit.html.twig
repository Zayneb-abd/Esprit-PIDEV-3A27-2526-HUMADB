{% extends 'employ/base_employe.html.twig' %}

{% block title %}Modifier commentaire{% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="fs-4 fw-bold mb-1">Modifier commentaire #{{ commentaire.id }}</h1>
    <p class="text-muted">Publication: #{{ commentaire.publication ? commentaire.publication.id : 'N/A' }}</p>
    <div class="card">
        <div class="card-body p-4">
            {{ form_start(form) }}
            {{ form_row(form.contenu) }}
            <div class="mt-3">
                <button class="btn btn-primary">Mettre a jour</button>
                <a class="btn btn-outline-secondary" href="{{ path('employ_publication_index') }}">Retour</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
