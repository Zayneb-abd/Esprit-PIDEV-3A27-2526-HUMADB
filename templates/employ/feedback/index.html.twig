{% extends 'employ/base_admin.html.twig' %}

{% block title %}Mes Feedbacks{% endblock %}

{% block body %}
<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fs-4 fw-bold mb-1">Mes Feedbacks</h1>
        <p class="text-muted mb-0">Consultez l'historique de vos requêtes et suggestions.</p>
    </div>
    <a href="{{ path('employ_feedback_new') }}" class="btn btn-primary shadow-sm rounded-pill px-4">
        <i class="ti ti-plus me-2"></i>Nouveau Feedback
    </a>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" action="{{ path('employ_feedback_index') }}" class="d-flex gap-2">
            <input
                type="text"
                name="q"
                value="{{ query|default('') }}"
                class="form-control form-control-sm"
                placeholder="Rechercher par message, categorie ou statut..."
            >
            <button type="submit" class="btn btn-sm btn-primary"><i class="ti ti-search"></i></button>
            {% if query is defined and query %}
                <a href="{{ path('employ_feedback_index') }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
            {% endif %}
        </form>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    {% for feedback in feedbacks %}
        <div class="col">
            <div class="card h-100 border-0 shadow-sm position-relative">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-light text-secondary border">
                            <i class="ti ti-tag me-1"></i>{{ feedback.category }}
                        </span>
                        
                        {% if feedback.status == 'nouveau' %}
                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2"><i class="ti ti-sparkles me-1"></i>Nouveau</span>
                        {% elseif feedback.status == 'en_cours' %}
                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2"><i class="ti ti-clock me-1"></i>En cours</span>
                        {% elseif feedback.status == 'traite' %}
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2"><i class="ti ti-check me-1"></i>Traité</span>
                        {% else %}
                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2">{{ feedback.status }}</span>
                        {% endif %}
                    </div>
                    
                    <p class="card-text text-dark" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                        {{ feedback.contenu }}
                    </p>
                </div>
                
                <div class="card-footer bg-transparent border-top-0 px-4 pb-4 pt-0 d-flex justify-content-between align-items-center">
                    <small class="text-muted"><i class="ti ti-calendar me-1"></i>{{ feedback.dateEnvoi ? feedback.dateEnvoi|date('d/m/Y') : '' }}</small>
                    <div class="d-flex gap-2">
                        {% if feedback.status == 'nouveau' %}
                            <a href="{{ path('employ_feedback_edit', {'id': feedback.id}) }}" class="btn btn-sm btn-outline-secondary rounded-pill">Modifier</a>
                        {% endif %}
                        <a href="{{ path('employ_feedback_show', {'id': feedback.id}) }}" class="btn btn-sm btn-outline-primary rounded-pill">Détails</a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="text-center py-5 bg-white rounded-3 shadow-sm border-0">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="ti ti-message-off fs-1 text-muted"></i>
                </div>
                <h4 class="fw-bold mb-2">Aucun feedback trouvé</h4>
                <p class="text-muted mb-4">Vous n'avez soumis aucun feedback ou plainte pour le moment.</p>
                <a href="{{ path('employ_feedback_new') }}" class="btn btn-primary rounded-pill px-4">Créer mon premier feedback</a>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
