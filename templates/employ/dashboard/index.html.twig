{% extends 'employ/base_employe.html.twig' %}

{% block title %}Espace Employé{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-4">
                <h1 class="fs-3 mb-1">Espace Employé</h1>
                <p class="mb-0">Bienvenue dans votre espace de gestion des congés et absences</p>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body text-center p-5">
                            <i class="ti ti-calendar-event fs-1 text-primary mb-3"></i>
                            <h5 class="card-title">Mes Congés</h5>
                            <p class="card-text text-muted">Consultez et gérez vos demandes de congés</p>
                            <a href="{{ path('employ_conges') }}" class="btn btn-primary">
                                <i class="ti ti-arrow-right"></i> Accéder
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body text-center p-5">
                            <i class="ti ti-calendar-off fs-1 text-warning mb-3"></i>
                            <h5 class="card-title">Mes Absences</h5>
                            <p class="card-text text-muted">Consultez vos absences enregistrées</p>
                            <a href="{{ path('employ_absences') }}" class="btn btn-warning">
                                <i class="ti ti-arrow-right"></i> Accéder
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block js %}
  <script src="{{ asset('admin/js/main.js') }}" type="module"></script>
{% endblock %}
