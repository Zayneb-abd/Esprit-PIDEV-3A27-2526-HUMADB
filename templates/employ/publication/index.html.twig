{% extends 'employ/base_admin.html.twig' %}

{% block title %}Publications{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fs-4 fw-bold mb-1">Publications et commentaires</h1>
            <p class="text-muted mb-0">CRUD des publications dans l'espace employe.</p>
        </div>
        <a href="{{ path('employ_publication_new') }}" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i> Nouvelle publication
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body p-3">
            <form method="get" action="{{ path('employ_publication_index') }}" class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label for="publication-search-employ" class="form-label mb-1">Recherche</label>
                    <input
                        id="publication-search-employ"
                        type="search"
                        name="q"
                        value="{{ search|default('') }}"
                        class="form-control"
                        placeholder="Rechercher par contenu, type, auteur ou email..."
                    >
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">Rechercher</button>
                    <a href="{{ path('employ_publication_index') }}" class="btn btn-outline-secondary w-100">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4">
        {% for publication in publications %}
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge text-bg-light border">#{{ publication.id }}</span>
                                    <span class="badge text-bg-primary">{{ publication.type ?: 'General' }}</span>
                                </div>
                                <h5 class="mb-2">Publication de {{ publication.user ? publication.user.prenom ~ ' ' ~ publication.user.nom : 'Utilisateur inconnu' }}</h5>
                                <p class="text-muted mb-0">{{ publication.datePublication ? publication.datePublication|date('d/m/Y H:i') : '-' }}</p>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="{{ path('employ_commentaire_new', { publication: publication.id }) }}" class="btn btn-sm btn-light">Ajouter commentaire</a>
                                <a href="{{ path('employ_publication_edit', { id: publication.id }) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                                <form method="post" action="{{ path('employ_publication_delete', { id: publication.id }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_publication_' ~ publication.id) }}">
                                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Supprimer cette publication ?');">Supprimer</button>
                                </form>
                            </div>
                        </div>

                        <hr>
                        <p class="mb-0">{{ publication.contenu }}</p>

                        <div class="mt-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0">Commentaires ({{ publication.commentaires|length }})</h6>
                            </div>

                            {% for commentaire in publication.commentaires %}
                                <div class="border rounded p-3 mb-2 bg-light-subtle">
                                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                        <div>
                                            <p class="mb-1">{{ commentaire.contenu }}</p>
                                            <small class="text-muted">
                                                {{ commentaire.user ? commentaire.user.prenom ~ ' ' ~ commentaire.user.nom : 'Utilisateur inconnu' }}
                                                - {{ commentaire.dateCommentaire ? commentaire.dateCommentaire|date('d/m/Y H:i') : '-' }}
                                            </small>
                                        </div>
                                        <div class="d-flex gap-1">
                                            <a href="{{ path('employ_commentaire_edit', { id: commentaire.id }) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                                            <form method="post" action="{{ path('employ_commentaire_delete', { id: commentaire.id }) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_commentaire_' ~ commentaire.id) }}">
                                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Supprimer ce commentaire ?');">Supprimer</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <div class="text-muted small">Aucun commentaire pour cette publication.</div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center py-5 text-muted">
                        Aucune publication.
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
