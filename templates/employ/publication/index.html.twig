{% extends 'employ/base_employe.html.twig' %}

{% block title %}Publications{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fs-4 fw-bold mb-1">Publications</h1>
            <p class="text-muted mb-0">Consultez les publications et ajoutez vos commentaires.</p>
        </div>
    </div>

    <div class="row g-4">
        {% for publication in publications %}
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge text-bg-light border">#{{ publication.id }}</span>
                                    <span class="badge text-bg-primary">{{ publication.type ?: 'General' }}</span>
                                </div>
                                <h5 class="mb-2">{{ publication.user ? publication.user.prenom ~ ' ' ~ publication.user.nom : 'Utilisateur inconnu' }}</h5>
                                <p class="text-muted mb-0">{{ publication.datePublication ? publication.datePublication|date('d/m/Y H:i') : '-' }}</p>
                            </div>
                        </div>

                        <hr>
                        <p class="mb-0">{{ publication.contenu }}</p>

                        <div class="mt-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0">Commentaires ({{ publication.commentaires|length }})</h6>
                            </div>

                            {% for commentaire in publication.commentaires %}
                                <div class="border rounded p-3 mb-2 bg-light-subtle">
                                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                        <div>
                                            <p class="mb-1">{{ commentaire.contenu }}</p>
                                            <small class="text-muted">
                                                {{ commentaire.user ? commentaire.user.prenom ~ ' ' ~ commentaire.user.nom : 'Utilisateur inconnu' }}
                                                - {{ commentaire.dateCommentaire ? commentaire.dateCommentaire|date('d/m/Y H:i') : '-' }}
                                            </small>
                                        </div>
                                        {% if commentaire.user == app.user %}
                                            <form method="post" action="{{ path('employ_comment_delete', { id: commentaire.id }) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ commentaire.id) }}">
                                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Supprimer ce commentaire ?');">Supprimer</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>
                            {% else %}
                                <div class="text-muted small">Aucun commentaire pour cette publication.</div>
                            {% endfor %}

                            {# Add comment form #}
                            <form method="post" action="{{ path('employ_publication_comment', { id: publication.id }) }}" class="mt-3">
                                <div class="input-group">
                                    <input type="text" name="contenu" class="form-control" placeholder="Ajouter un commentaire..." required>
                                    <button class="btn btn-primary" type="submit">
                                        <i class="ti ti-send me-1"></i>Envoyer
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center py-5 text-muted">
                        Aucune publication.
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
