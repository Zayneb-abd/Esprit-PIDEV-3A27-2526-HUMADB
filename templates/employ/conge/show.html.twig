{% extends 'admin/base_admin.html.twig' %}

{% block title %}Détails Demande de Congé{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-4">
                <h1 class="fs-3 mb-1">Détails Demande de Congé</h1>
                <p class="mb-0">Demande #{{ id }}</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="card-title mb-0">Informations de la demande</h5>
                        <div>
                            <a href="{{ path('employ_conges_edit', {'id': id}) }}" class="btn btn-warning btn-sm me-2">
                                <i class="ti ti-edit"></i> Modifier
                            </a>
                            <form method="post" action="{{ path('employ_conges_delete', {'id': id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette demande ?');">
                                <button type="submit" class="btn btn-danger btn-sm me-2">
                                    <i class="ti ti-trash"></i> Supprimer
                                </button>
                            </form>
                            <a href="{{ path('employ_conges') }}" class="btn btn-secondary btn-sm">
                                <i class="ti ti-arrow-left"></i> Retour
                            </a>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td class="fw-bold">ID :</td>
                                    <td>{{ id }}</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Date de demande :</td>
                                    <td>-</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Date de début :</td>
                                    <td>-</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Date de fin :</td>
                                    <td>-</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td class="fw-bold">Type :</td>
                                    <td>-</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Statut :</td>
                                    <td><span class="badge bg-secondary">En attente</span></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Durée :</td>
                                    <td>-</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Motif :</td>
                                    <td>-</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
