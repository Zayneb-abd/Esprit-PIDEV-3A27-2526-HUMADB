{% extends 'employ/base_employe.html.twig' %}

{% block title %}Modifier la Formation{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-4">
                <h1 class="fs-3 mb-1">Modifier la Formation</h1>
                <p class="mb-0">Mettez à jour les informations de la formation</p>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-8 col-12 mx-auto">
            <div class="card p-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    <div class="mb-3">
                        {{ form_row(form.sujet) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.formateur) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.type) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.dateDebut) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.duree) }}
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Localisation</label>
                        <div id="locationSelectionSection">
                            <button type="button" class="btn btn-outline-primary mb-3" data-bs-toggle="modal" data-bs-target="#locationModal">
                                <i class="ti ti-map-pin"></i> Sélectionner la localisation sur la carte
                            </button>
                            <div id="selectedLocation" class="alert alert-info d-none">
                                <strong>Localisation sélectionnée:</strong> <span id="locationText"></span>
                            </div>
                        </div>
                        {{ form_widget(form.localisation, {'attr': {'class': 'd-none'}}) }}
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Mettre à jour</button>
                        <a href="{{ path('employ_formation_index') }}" class="btn btn-outline-secondary">Retour à la liste</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<!-- Location Selection Modal -->
<div class="modal fade" id="locationModal" tabindex="-1" aria-labelledby="locationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="locationModalLabel">Sélectionner la localisation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <div class="row">
                        <div class="col-md-8">
                            <input type="text" id="addressInput" class="form-control" placeholder="Rechercher une adresse...">
                        </div>
                        <div class="col-md-2">
                            <button type="button" id="searchBtn" class="btn btn-outline-primary w-100">
                                <i class="ti ti-search"></i> Rechercher
                            </button>
                        </div>
                        <div class="col-md-2">
                            <button type="button" id="currentLocationBtn" class="btn btn-outline-secondary w-100">
                                <i class="ti ti-location"></i> Ma position
                            </button>
                        </div>
                    </div>
                </div>
                <div id="selectionMap" style="height: 400px; width: 100%; border: 1px solid #ddd; border-radius: 4px;"></div>
                <div class="mt-3">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Latitude:</label>
                            <input type="text" id="modalLatitude" class="form-control" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Longitude:</label>
                            <input type="text" id="modalLongitude" class="form-control" readonly>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" id="confirmLocationBtn" class="btn btn-primary">Confirmer la localisation</button>
            </div>
        </div>
    </div>
</div>

<script>
// Show/hide location section based on formation type
function toggleLocationSection() {
    const typeField = document.querySelector('select[name="formation[type]"]') || document.querySelector('#formation_type');
    const locationSection = document.getElementById('locationSelectionSection');
    
    console.log('Type field found:', !!typeField);
    console.log('Location section found:', !!locationSection);
    
    if (typeField && locationSection) {
        const selectedType = typeField.value;
        console.log('Selected type:', selectedType); // Debug log
        if (selectedType === 'Présentiel' || selectedType === 'Hybride') {
            locationSection.style.display = 'block';
            console.log('Showing location section'); // Debug log
        } else {
            locationSection.style.display = 'none';
            console.log('Hiding location section'); // Debug log
        }
    } else {
        // If type field not found, show location section by default
        if (locationSection) {
            locationSection.style.display = 'block';
            console.log('Section localisation affichée par défaut');
        }
    }
}

// Initialize OpenStreetMap for location selection
let selectionMap;
let selectionMarker;

function initSelectionMap() {
    if (selectionMap) return; // Already initialized
    
    // Default center (Tunis)
    const center = [36.8065, 10.1815];
    
    selectionMap = L.map('selectionMap').setView(center, 12);
    
    // Add OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(selectionMap);
    
    // Add draggable marker
    selectionMarker = L.marker(center, {
        draggable: true
    }).addTo(selectionMap);
    
    // Update coordinates when marker is dragged
    selectionMarker.on('dragend', function(event) {
        const position = event.target.getLatLng();
        updateModalCoordinates(position.lat, position.lng);
    });
    
    // Update coordinates when map is clicked
    selectionMap.on('click', function(event) {
        const position = event.latlng;
        selectionMarker.setLatLng(position);
        updateModalCoordinates(position.lat, position.lng);
    });
    
    // Load existing location if any
    const localisationInput = document.querySelector('#formation_localisation');
    if (localisationInput && localisationInput.value) {
        const coords = localisationInput.value.split(',');
        if (coords.length === 2) {
            const lat = parseFloat(coords[0]);
            const lng = parseFloat(coords[1]);
            if (!isNaN(lat) && !isNaN(lng)) {
                selectionMap.setView([lat, lng], 13);
                selectionMarker.setLatLng([lat, lng]);
                updateModalCoordinates(lat, lng);
            }
        }
    }
}

function updateModalCoordinates(lat, lng) {
    document.getElementById('modalLatitude').value = lat.toFixed(6);
    document.getElementById('modalLongitude').value = lng.toFixed(6);
    
    // Get place name from coordinates using reverse geocoding
    getPlaceName(lat, lng);
}

function getPlaceName(lat, lng) {
    fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`)
        .then(response => response.json())
        .then(data => {
            if (data && data.display_name) {
                // Update display with place name instead of coordinates
                const locationDisplay = document.getElementById('locationText');
                if (locationDisplay) {
                    locationDisplay.textContent = data.display_name;
                }
            } else {
                // Fallback to coordinates if no place name found
                const locationDisplay = document.getElementById('locationText');
                if (locationDisplay) {
                    locationDisplay.textContent = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                }
            }
        })
        .catch(error => {
            console.error('Reverse geocoding error:', error);
            // Fallback to coordinates on error
            const locationDisplay = document.getElementById('locationText');
            if (locationDisplay) {
                locationDisplay.textContent = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
            }
        });
}

// Search address using Nominatim
document.getElementById('searchBtn')?.addEventListener('click', function() {
    const address = document.getElementById('addressInput').value;
    if (address && selectionMap) {
        fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}`)
            .then(response => response.json())
            .then(data => {
                if (data && data.length > 0) {
                    const result = data[0];
                    const lat = parseFloat(result.lat);
                    const lng = parseFloat(result.lon);
                    
                    selectionMap.setView([lat, lng], 15);
                    selectionMarker.setLatLng([lat, lng]);
                    updateModalCoordinates(lat, lng);
                }
            })
            .catch(error => {
                console.error('Search error:', error);
            });
    }
});

// Use current location
document.getElementById('currentLocationBtn')?.addEventListener('click', function() {
    if (navigator.geolocation && selectionMap) {
        navigator.geolocation.getCurrentPosition(function(position) {
            const lat = position.coords.latitude;
            const lng = position.coords.longitude;
            
            selectionMap.setView([lat, lng], 15);
            selectionMarker.setLatLng([lat, lng]);
            updateModalCoordinates(lat, lng);
        }, function(error) {
            console.error('Geolocation error:', error);
        });
    }
});

// Confirm location
document.getElementById('confirmLocationBtn')?.addEventListener('click', function() {
    const lat = document.getElementById('modalLatitude').value;
    const lng = document.getElementById('modalLongitude').value;
    const locationText = document.getElementById('locationText').textContent;
    
    if (lat && lng) {
        // Update the hidden localisation field with coordinates (for database)
        document.getElementById('formation_localisation').value = `${lat},${lng}`;
        
        // Update the display with place name (for user)
        document.getElementById('selectedLocation').classList.remove('d-none');
        // Use the place name if available, otherwise fallback to coordinates
        const displayText = locationText && locationText !== `${lat},${lng}` ? locationText : `${lat}, ${lng}`;
        document.getElementById('locationText').textContent = displayText;
        
        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('locationModal'));
        modal.hide();
    }
});

// Initialize when modal is shown
document.getElementById('locationModal')?.addEventListener('shown.bs.modal', function() {
    if (typeof L !== 'undefined') {
        initSelectionMap();
    } else {
        // Load Leaflet if not already loaded
        const leafletCSS = document.createElement('link');
        leafletCSS.rel = 'stylesheet';
        leafletCSS.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(leafletCSS);
        
        const leafletJS = document.createElement('script');
        leafletJS.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        leafletJS.onload = function() {
            initSelectionMap();
        };
        document.head.appendChild(leafletJS);
    }
});

// Initialize location section toggle on page load
document.addEventListener('DOMContentLoaded', function() {
    toggleLocationSection();
    
    // Add event listener for type change
    const typeSelect = document.querySelector('select[name="formation[type]"]') || document.querySelector('#formation_type');
    if (typeSelect) {
        typeSelect.addEventListener('change', toggleLocationSection);
    }
    
    // Load existing location if any
    const localisationInput = document.querySelector('#formation_localisation');
    if (localisationInput && localisationInput.value) {
        document.getElementById('selectedLocation').classList.remove('d-none');
        document.getElementById('locationText').textContent = localisationInput.value;
    }
});
</script>
{% endblock %}
