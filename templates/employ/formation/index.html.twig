{% extends 'employ/base_employe.html.twig' %}

{% block title %}Gestion des Formations{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fs-3 mb-1">Gestion des Formations</h1>
                    <p class="mb-0">Liste de toutes les formations disponibles</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="{{ path('employ_participation_formations') }}" class="btn btn-outline-primary">Gestion des participations</a>
                    <a href="{{ path('employ_participation_index') }}" class="btn btn-outline-secondary">Mes participations</a>
                    <a href="{{ path('employ_formation_new') }}" class="btn btn-primary">Ajouter une Formation</a>
                </div>
            </div>

            <div class="card p-3 mb-4">
                <form action="{{ path('employ_formation_index') }}" method="GET" class="row g-3">
                    <div class="col-md-10">
                        <input type="text" name="q" class="form-control" placeholder="Rechercher par sujet, formateur, type ou localisation..." value="{{ query }}">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-secondary w-100">
                            <i class="ti ti-search"></i> Rechercher
                        </button>
                    </div>
                </form>
            </div>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card table-responsive">
                <table class="table mb-0 text-nowrap table-hover">
                    <thead class="table-light border-light">
                        <tr>
                            <th>
                                <a href="{{ path('employ_formation_index', {q: query, sort: 'sujet', order: sort == 'sujet' and order == 'ASC' ? 'DESC' : 'ASC'}) }}">
                                    Sujet {% if sort == 'sujet' %}<i class="ti ti-chevron-{{ order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('employ_formation_index', {q: query, sort: 'formateur', order: sort == 'formateur' and order == 'ASC' ? 'DESC' : 'ASC'}) }}">
                                    Formateur {% if sort == 'formateur' %}<i class="ti ti-chevron-{{ order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('employ_formation_index', {q: query, sort: 'type', order: sort == 'type' and order == 'ASC' ? 'DESC' : 'ASC'}) }}">
                                    Type {% if sort == 'type' %}<i class="ti ti-chevron-{{ order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('employ_formation_index', {q: query, sort: 'dateDebut', order: sort == 'dateDebut' and order == 'ASC' ? 'DESC' : 'ASC'}) }}">
                                    Date Début {% if sort == 'dateDebut' %}<i class="ti ti-chevron-{{ order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('employ_formation_index', {q: query, sort: 'duree', order: sort == 'duree' and order == 'ASC' ? 'DESC' : 'ASC'}) }}">
                                    Durée {% if sort == 'duree' %}<i class="ti ti-chevron-{{ order == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}
                                </a>
                            </th>
                            <th>Localisation</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for formation in formations %}
                        <tr class="align-middle">
                            <td>{{ formation.sujet }}</td>
                            <td>{{ formation.formateur }}</td>
                            <td>
                                <span class="badge 
                                    {% if formation.type == 'Présentiel' %}bg-primary
                                    {% elseif formation.type == 'Hybride' %}bg-info
                                    {% else %}bg-secondary{% endif %}">
                                    {{ formation.type }}
                                </span>
                            </td>
                            <td>{{ formation.dateDebut ? formation.dateDebut|date('Y-m-d') : '' }}</td>
                            <td>{{ formation.duree }}</td>
                            <td>
                                {% if formation.localisation and (formation.type == 'Présentiel' or formation.type == 'Hybride') %}
                                    {% set coordinates = null %}
                                    {% if formation.localisation matches '/(-?\d+\.\d+),(-?\d+\.\d+)/' %}
                                        {% set coordinates = {latitude: matches[1], longitude: matches[2]} %}
                                    {% endif %}
                                    
                                    {% if coordinates %}
                                        <button class="btn btn-sm btn-primary" onclick="showFormationLocationModal({{ coordinates.latitude }}, {{ coordinates.longitude }}, '{{ formation.sujet|e('js') }}')">
                                            <i class="ti ti-map-pin"></i> Localisation
                                        </button>
                                    {% else %}
                                        <span class="text-muted">{{ formation.localisation }}</span>
                                    {% endif %}
                                {% elseif formation.type == 'En ligne' %}
                                    <span class="badge bg-secondary">En ligne</span>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('employ_formation_edit', {'id': formation.id}) }}"><i class="ti ti-edit"></i></a>
                                {{ include('employ/formation/_delete_form.html.twig') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center">Aucune formation trouvée</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Formation Location Modal -->
<div class="modal fade" id="formationLocationModal" tabindex="-1" aria-labelledby="formationLocationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="formationLocationModalLabel">Localisation de la formation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="formationLocationMap" style="height: 400px; width: 100%; border: 1px solid #ddd; border-radius: 4px;"></div>
                <div class="mt-3">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Latitude:</label>
                            <input type="text" id="formationModalLatitude" class="form-control" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Longitude:</label>
                            <input type="text" id="formationModalLongitude" class="form-control" readonly>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <small class="text-muted">Cliquez sur le marqueur pour voir les détails de la formation</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<script>
let formationLocationModalMap;
let formationLocationModalMarker;

function showFormationLocationModal(lat, lng, title) {
    // Load Leaflet if not already loaded
    if (typeof L === 'undefined') {
        // Load CSS
        const leafletCSS = document.createElement('link');
        leafletCSS.rel = 'stylesheet';
        leafletCSS.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(leafletCSS);
        
        // Load JS
        const leafletJS = document.createElement('script');
        leafletJS.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        leafletJS.onload = function() {
            createFormationLocationModalMap(lat, lng, title);
        };
        document.head.appendChild(leafletJS);
    } else {
        createFormationLocationModalMap(lat, lng, title);
    }
}

function createFormationLocationModalMap(lat, lng, title) {
    // Initialize map if not already done
    if (!formationLocationModalMap) {
        const location = [lat, lng];
        
        formationLocationModalMap = L.map('formationLocationMap').setView(location, 15);
        
        // Add OpenStreetMap tiles
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(formationLocationModalMap);
        
        // Add marker
        formationLocationModalMarker = L.marker(location).addTo(formationLocationModalMap);
        formationLocationModalMarker.bindPopup(title).openPopup();
    } else {
        // Update existing map
        const location = [lat, lng];
        formationLocationModalMap.setView(location, 15);
        formationLocationModalMarker.setLatLng(location);
        formationLocationModalMarker.setPopupContent(title);
        formationLocationModalMarker.openPopup();
    }
    
    // Update modal title
    document.getElementById('formationLocationModalLabel').textContent = 'Localisation: ' + title;
    
    // Update coordinate fields
    document.getElementById('formationModalLatitude').value = lat.toFixed(6);
    document.getElementById('formationModalLongitude').value = lng.toFixed(6);
    
    // Show modal
    const modal = new bootstrap.Modal(document.getElementById('formationLocationModal'));
    modal.show();
}

// Load Leaflet when page loads
window.addEventListener('load', function() {
    // Load CSS
    const leafletCSS = document.createElement('link');
    leafletCSS.rel = 'stylesheet';
    leafletCSS.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
    document.head.appendChild(leafletCSS);
    
    // Load JS
    const leafletJS = document.createElement('script');
    leafletJS.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    document.head.appendChild(leafletJS);
});
</script>
{% endblock %}
