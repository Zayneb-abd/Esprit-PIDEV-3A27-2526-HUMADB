{% extends 'employ/base_employe.html.twig' %}

{% block title %}Ajouter une Formation{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-4">
                <h1 class="fs-3 mb-1">Ajouter une Formation</h1>
                <p class="mb-0">Remplissez les informations ci-dessous</p>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-8 col-12 mx-auto">
            <div class="card p-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    <div class="mb-3">
                        {{ form_row(form.sujet) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.formateur) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.type) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.dateDebut) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.duree) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.localisation) }}
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                        <a href="{{ path('employ_formation_index') }}" class="btn btn-outline-secondary">Retour à la liste</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
