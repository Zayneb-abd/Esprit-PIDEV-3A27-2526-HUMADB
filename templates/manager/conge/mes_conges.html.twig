{% extends 'manager/base_manager.html.twig' %}

{% block title %}Mes Congés{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fs-3 mb-1">Mes Congés</h1>
                    <p class="mb-0 text-muted">Gérez vos demandes de congés</p>
                </div>
                <a href="{{ path('manager_mes_conges_new') }}" class="btn btn-primary">
                    <i class="ti ti-plus"></i> Nouvelle demande
                </a>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    {% if conges is empty %}
                        <div class="text-center py-5">
                            <i class="ti ti-calendar-off fs-1 text-muted mb-3"></i>
                            <p class="text-muted">Aucune demande de congé pour le moment.</p>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Date début</th>
                                        <th>Date fin</th>
                                        <th>Statut</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for conge in conges %}
                                        <tr>
                                            <td>{{ conge.absence.typeAbsence }}</td>
                                            <td>{{ conge.absence.dateDebut|date('d/m/Y') }}</td>
                                            <td>{{ conge.absence.dateFin|date('d/m/Y') }}</td>
                                            <td>
                                                <span class="badge bg-{{ conge.absence.statut == 'approuve' ? 'success' : (conge.absence.statut == 'refuse' ? 'danger' : 'warning') }}">
                                                    {{ conge.absence.statut == 'en_attente' ? 'En attente' : (conge.absence.statut == 'approuve' ? 'Approuvé' : 'Refusé') }}
                                                </span>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary">
                                                    <i class="ti ti-eye"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
