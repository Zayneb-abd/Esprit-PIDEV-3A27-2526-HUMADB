<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background: #F59E0B; color: white; padding: 20px; text-align: center; }
        .content { background: #f9f9f9; padding: 20px; margin: 20px 0; }
        .footer { text-align: center; color: #666; font-size: 12px; margin-top: 30px; }
        .btn { display: inline-block; background: #F59E0B; color: white; padding: 12px 24px; text-decoration: none; border-radius: 5px; }
        .info-box { background: white; padding: 15px; margin: 15px 0; border-left: 4px solid #F59E0B; }
        .alert { background: #FEF3C7; border: 1px solid #F59E0B; padding: 10px; border-radius: 5px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📋 Nouvelle Demande de Congé</h1>
        </div>
        
        <div class="content">
            <p>Bonjour {{ manager.prenom }} {{ manager.nom }},</p>
            
            <div class="alert">
                <strong>{{ employee.prenom }} {{ employee.nom }}</strong> a soumis une nouvelle demande de congé qui nécessite votre validation.
            </div>
            
            <div class="info-box">
                <h3>Détails de la demande :</h3>
                <ul>
                    <li><strong>Employé :</strong> {{ employee.prenom }} {{ employee.nom }}</li>
                    <li><strong>Email :</strong> {{ employee.email }}</li>
                    <li><strong>Type :</strong> {{ conge.absence.typeAbsence }}</li>
                    <li><strong>Date début :</strong> {{ conge.absence.dateDebut|date('d/m/Y') }}</li>
                    <li><strong>Date fin :</strong> {{ conge.absence.dateFin|date('d/m/Y') }}</li>
                </ul>
            </div>
            
            <p style="text-align: center; margin-top: 30px;">
                <a href="http://127.0.0.1:8000/manager/conges" class="btn">Traiter la demande</a>
            </p>
        </div>
        
        <div class="footer">
            <p>HUMA RH System - Gestion des Congés et Absences</p>
        </div>
    </div>
</body>
</html>
