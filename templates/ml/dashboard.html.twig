{% extends 'base_employe.html.twig' %}

{% block title %}🤖 ML Dashboard - Prédictions{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1><i class="fas fa-brain text-primary"></i> Machine Learning - Gestion des Congés</h1>
    <p class="text-muted">Prédictions intelligentes basées sur votre historique</p>
    
    <div class="row mt-4">
        <!-- Carte 1: Prédiction Prochain Congé -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-primary text-white">
                    <h5><i class="fas fa-crystal-ball"></i> Prochain Congé</h5>
                </div>
                <div class="card-body">
                    {% if prediction.success %}
                        <div class="text-center">
                            <div class="display-4 text-primary">
                                {{ (prediction.data.probability_conge * 100)|round }}%
                            </div>
                            <p class="text-muted">Probabilité ce mois</p>
                        </div>
                        
                        {% if prediction.data.confidence > 0.5 %}
                            <div class="alert alert-info mt-3">
                                <strong><i class="fas fa-lightbulb"></i> Suggestion:</strong><br>
                                Période recommandée: <strong>{{ prediction.data.recommended_period }}</strong><br>
                                Durée suggérée: <strong>{{ prediction.data.suggested_duration }} jours</strong>
                            </div>
                        {% endif %}
                        
                        <div class="progress mt-3">
                            <div class="progress-bar bg-success" role="progressbar" 
                                 style="width: {{ prediction.data.confidence * 100 }}%">
                                Confiance: {{ (prediction.data.confidence * 100)|round }}%
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            {{ prediction.error|default('Prédiction indisponible') }}
                        </div>
                        {% if prediction.fallback is defined %}
                            <hr>
                            <small class="text-muted">Estimation basique:</small>
                            <div class="mt-2">
                                <strong>{{ (prediction.fallback.probability_conge * 100)|round }}%</strong> 
                                ce mois (basé sur saisonnalité)
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>
        
        <!-- Carte 2: Meilleure Période -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-success text-white">
                    <h5><i class="fas fa-calendar-check"></i> Meilleure Période</h5>
                </div>
                <div class="card-body">
                    {% if suggestion.best_period %}
                        <h4 class="text-success">
                            <i class="fas fa-star"></i>
                            {{ suggestion.best_period.month_name }}
                        </h4>
                        <p class="text-muted">{{ suggestion.best_period.reason }}</p>
                        
                        <hr>
                        
                        <h6>Autres suggestions:</h6>
                        <ul class="list-unstyled">
                            {% for sug in suggestion.suggestions|slice(1, 2) %}
                                <li>
                                    <span class="badge bg-secondary">{{ sug.month_name }}</span>
                                    <small class="text-muted">(Score: {{ sug.score }})</small>
                                </li>
                            {% endfor %}
                        </ul>
                        
                        <div class="alert alert-warning mt-3">
                            <small><i class="fas fa-ban"></i> 
                                Éviter: {{ suggestion.avoid_periods }}
                            </small>
                        </div>
                    {% else %}
                        <p class="text-muted">Pas de suggestion disponible</p>
                    {% endif %}
                </div>
            </div>
        </div>
        
    </div>
    
    <!-- Historique -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-history"></i> Historique des congés (données d'entraînement)</h5>
                </div>
                <div class="card-body">
                    {% if historique_conges|length > 0 %}
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date demande</th>
                                    <th>Période</th>
                                    <th>Durée</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for conge in historique_conges %}
                                    <tr>
                                        <td>{{ conge.dateDemande|date('d/m/Y') }}</td>
                                        <td>
                                            {{ conge.absence.dateDebut|date('d/m') }} - 
                                            {{ conge.absence.dateFin|date('d/m/Y') }}
                                        </td>
                                        <td>
                                            {{ conge.absence.dateFin.diff(conge.absence.dateDebut).days + 1 }} j
                                        </td>
                                        <td>
                                            <span class="badge bg-{{ conge.absence.statut == 'approuvee' ? 'success' : (conge.absence.statut == 'en_attente' ? 'warning' : 'danger') }}">
                                                {{ conge.absence.statut }}
                                            </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        
                        {% if historique_conges|length < 3 %}
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i>
                                Minimum 3 congés requis pour une prédiction ML précise.
                                Vous avez {{ historique_conges|length }} congé(s) enregistré(s).
                            </div>
                        {% endif %}
                    {% else %}
                        <p class="text-muted">Aucun historique de congés pour l'entraînement ML</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
