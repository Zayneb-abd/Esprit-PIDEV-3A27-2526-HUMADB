<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription - HUMA Gestion des Ressources Humaines</title>
    <link href="{{ asset('logo/huma.png') }}" rel="icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-teal: #1a5f5f;
            --primary-teal-light: #2d7a7a;
            --accent-cyan: #4ecdc4;
            --dark-bg: #1a3a3a;
            --text-dark: #2c3e50;
            --bg-light: #f8f9fa;
        }
        
        body {
            background: linear-gradient(135deg, var(--bg-light) 0%, #e8f4f4 100%);
            font-family: 'Open Sans', sans-serif;
            min-height: 100vh;
        }
        
        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(26, 95, 95, 0.15);
            background: white;
        }
        
        .huma-brand {
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            font-size: 2.2rem;
            background: linear-gradient(135deg, var(--primary-teal) 0%, var(--accent-cyan) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, var(--primary-teal) 0%, var(--accent-cyan) 100%);
            border: none;
            padding: 0.8rem;
            font-weight: 600;
            border-radius: 30px;
            transition: all 0.3s ease;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(26, 95, 95, 0.3);
            background: linear-gradient(135deg, var(--primary-teal-light) 0%, var(--accent-cyan) 100%);
        }
        
        .link-primary {
            color: var(--primary-teal);
            text-decoration: none;
            font-weight: 500;
        }
        
        .link-primary:hover {
            color: var(--accent-cyan);
            text-decoration: underline;
        }
        
        .form-control, .form-select {
            border-radius: 10px;
            border: 2px solid #e9ecef;
            padding: 0.6rem 0.75rem;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: var(--accent-cyan);
            box-shadow: 0 0 0 0.2rem rgba(78, 205, 196, 0.25);
        }
        
        .card-title {
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            color: var(--text-dark);
        }
        
        .form-label {
            font-weight: 500;
            color: var(--text-dark);
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="container d-flex align-items-center justify-content-center min-vh-100 py-4">
        <div class="card" style="max-width:480px; width:100%;">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <a href="{{ path('client_home') }}" class="text-decoration-none">
                        <div class="huma-brand mb-2">HUMA</div>
                    </a>
                    <h1 class="card-title mb-1 h5">Créer un compte</h1>
                    <p class="text-muted small">Gestion des Ressources Humaines</p>
                </div>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show py-2" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {{ form_start(form, { attr: { novalidate: 'novalidate', enctype: 'multipart/form-data', class: 'mt-3' } }) }}
                
                <div class="text-danger mb-3 font-weight-bold">
                    {{ form_errors(form) }}
                </div>

                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label small">Prénom</label>
                        {{ form_widget(form.prenom, { attr: { class: 'form-control form-control-sm', placeholder: 'Jane' } }) }}
                        {{ form_errors(form.prenom) }}
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Nom</label>
                        {{ form_widget(form.nom, { attr: { class: 'form-control form-control-sm', placeholder: 'Doe' } }) }}
                        {{ form_errors(form.nom) }}
                    </div>
                </div>

                <div class="mb-3 mt-3">
                    <label class="form-label small">Email</label>
                    {{ form_widget(form.email, { attr: { class: 'form-control form-control-sm', placeholder: 'name@example.com' } }) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="mb-3">
                    <label class="form-label small">Date de naissance</label>
                    {{ form_widget(form.date_naissance, { attr: { class: 'form-control form-control-sm' } }) }}
                    {{ form_errors(form.date_naissance) }}
                </div>

                <div class="mb-3">
                    <label class="form-label small">Mot de passe</label>
                    {{ form_widget(form.plainPassword.first, { attr: { class: 'form-control form-control-sm', placeholder: 'Min. 8 caractères, 1 majuscule, 1 chiffre' } }) }}
                    {{ form_errors(form.plainPassword.first) }}
                </div>

                <div class="mb-3">
                    <label class="form-label small">Confirmer le mot de passe</label>
                    {{ form_widget(form.plainPassword.second, { attr: { class: 'form-control form-control-sm', placeholder: 'Répéter le mot de passe' } }) }}
                    {{ form_errors(form.plainPassword.second) }}
                    {{ form_errors(form.plainPassword) }}
                </div>

                <div class="mb-3">
                    <label class="form-label small">Photo de profil <span class="text-muted">(optionnel)</span></label>
                    {{ form_widget(form.faceImageFile, { attr: { class: 'form-control form-control-sm' } }) }}
                    {{ form_errors(form.faceImageFile) }}
                </div>

                <button class="btn btn-primary w-100" type="submit">Créer mon compte</button>

                {{ form_end(form) }}

                <div class="text-center mt-3 small text-muted">
                    Déjà un compte ? <a href="{{ path('app_login') }}" class="link-primary">Se connecter</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
