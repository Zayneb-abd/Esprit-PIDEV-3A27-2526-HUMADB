{% extends is_granted('ROLE_EMPLOYE') ? 'employ/base_employe.html.twig' : (is_granted('ROLE_CANDIDAT') or is_granted('ROLE_CONDIDAT') ? 'candidat/base_candidat.html.twig' : 'base_user.html.twig') %}

{% block title %}Changer le mot de passe{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-lg-5">

        <div class="mb-3">
            <a href="{{ path('user_profile') }}" class="text-muted text-decoration-none small">
                ← Retour au profil
            </a>
            <h4 class="fw-bold mt-1">Changer le mot de passe</h4>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="card shadow-sm">
            <div class="card-body p-4">
                {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

                <div class="mb-3">
                    <label class="form-label">Ancien mot de passe</label>
                    {{ form_widget(form.oldPassword, { attr: { class: 'form-control', placeholder: 'Votre mot de passe actuel' } }) }}
                    {{ form_errors(form.oldPassword) }}
                </div>

                <div class="mb-3">
                    <label class="form-label">Nouveau mot de passe</label>
                    {{ form_widget(form.newPassword.first, { attr: { class: 'form-control', placeholder: 'Min. 8 car., 1 majuscule, 1 chiffre' } }) }}
                </div>

                <div class="mb-4">
                    <label class="form-label">Confirmer le nouveau mot de passe</label>
                    {{ form_widget(form.newPassword.second, { attr: { class: 'form-control', placeholder: 'Répéter le mot de passe' } }) }}
                    {{ form_errors(form.newPassword.second) }}
                    {{ form_errors(form.newPassword) }}
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">Modifier</button>
                    <a href="{{ path('user_profile') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

    </div>
</div>
{% endblock %}
