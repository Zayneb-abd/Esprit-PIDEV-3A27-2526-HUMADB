{% extends is_granted('ROLE_MANAGER') ? 'manager/base_manager.html.twig' : (is_granted('ROLE_EMPLOYE') ? 'employ/base_employe.html.twig' : (is_granted('ROLE_CANDIDAT') or is_granted('ROLE_CONDIDAT') ? 'candidat/base_candidat.html.twig' : 'base_user.html.twig')) %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-lg-6">

        <div class="mb-3 d-flex justify-content-between align-items-start">
            <div>
                <a href="{{ path('user_profile') }}" class="text-muted text-decoration-none small">
                    ← Retour au profil
                </a>
                <h4 class="fw-bold mt-1">Modifier mon profil</h4>
            </div>
            <a href="{{ path('user_profile') }}" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                {{ form_start(form, { attr: { novalidate: 'novalidate', enctype: 'multipart/form-data' } }) }}

                <div class="mb-3">
                    <label class="form-label">Prénom</label>
                    {{ form_widget(form.prenom, { attr: { class: 'form-control' } }) }}
                    {{ form_errors(form.prenom) }}
                </div>

                <div class="mb-3">
                    <label class="form-label">Nom</label>
                    {{ form_widget(form.nom, { attr: { class: 'form-control' } }) }}
                    {{ form_errors(form.nom) }}
                </div>

                <div class="mb-3">
                    <label class="form-label">Date de naissance</label>
                    {{ form_widget(form.date_naissance, { attr: { class: 'form-control' } }) }}
                    {{ form_errors(form.date_naissance) }}
                </div>

                <div class="mb-4">
                    <label class="form-label">Photo de profil <span class="text-muted small">(optionnel)</span></label>
                    {{ form_widget(form.faceImageFile, { attr: { class: 'form-control' } }) }}
                    {{ form_errors(form.faceImageFile) }}
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">Enregistrer</button>
                    <a href="{{ path('user_profile') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

    </div>
</div>
{% endblock %}
