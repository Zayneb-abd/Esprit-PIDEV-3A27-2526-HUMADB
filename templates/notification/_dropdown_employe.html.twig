<a class="nav-link position-relative p-2" href="#" role="button" data-bs-toggle="dropdown">
    <i class="ti ti-bell fs-5"></i>
    {% if unread_count > 0 %}
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger notification-badge">
            {{ unread_count }}
        </span>
    {% endif %}
</a>
<div class="dropdown-menu dropdown-menu-end p-0" style="min-width: 300px;">
    <div class="p-3 border-bottom">
        <h6 class="mb-0">Notifications</h6>
    </div>
    <div class="p-0">
        {% for notification in notifications %}
            <a href="{{ path('notification_mark_read', {'id': notification.id}) }}" class="d-flex align-items-center p-3 text-decoration-none text-dark border-bottom hover-bg">
                <div class="flex-grow-1">
                    <p class="mb-0 small fw-medium">{{ notification.title }}</p>
                    <p class="mb-0 text-muted" style="font-size: 11px;">{{ notification.message|slice(0, 40) ~ (notification.message|length > 40 ? '...' : '') }}</p>
                    <p class="mb-0 text-muted" style="font-size: 11px;">{{ notification.createdAt|date('d/m/Y H:i') }}</p>
                </div>
            </a>
        {% else %}
            <div class="p-3 text-center text-muted small">
                Aucune nouvelle notification.
            </div>
        {% endfor %}
    </div>
    <div class="p-2 text-center">
        <span class="text-primary small text-decoration-none" style="cursor: default;">---</span>
    </div>
</div>
