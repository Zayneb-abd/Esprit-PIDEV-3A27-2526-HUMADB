<a class="position-relative btn-icon btn-sm btn-light btn rounded-circle" data-bs-toggle="dropdown"
    aria-expanded="false" href="#" role="button">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
        class="icon icon-tabler icons-tabler-outline icon-tabler-bell">
        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
        <path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6" />
        <path d="M9 17v1a3 3 0 0 0 6 0v-1" />
    </svg>
    {% if unread_count > 0 %}
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger mt-2 ms-n2">
            {{ unread_count }}
            <span class="visually-hidden">messages non lus</span>
        </span>
    {% endif %}
</a>
<div class="dropdown-menu dropdown-menu-end dropdown-menu-md p-0">
    <ul class="list-unstyled p-0 m-0">
        {% for notification in notifications %}
            <li class="p-3 border-bottom">
                <a href="{{ path('notification_mark_read', {'id': notification.id}) }}" class="d-flex gap-3 text-decoration-none text-dark">
                    <div class="flex-grow-1 small">
                        <p class="mb-0 fw-bold">{{ notification.title }}</p>
                        <p class="mb-1 text-muted">{{ notification.message|slice(0, 40) ~ (notification.message|length > 40 ? '...' : '') }}</p>
                        <div class="text-secondary" style="font-size: 11px;">{{ notification.createdAt|date('d/m/Y H:i') }}</div>
                    </div>
                </a>
            </li>
        {% else %}
            <li class="p-3 text-center text-muted">
                Aucune nouvelle notification.
            </li>
        {% endfor %}
        <li class="px-4 py-3 text-center">
            <span class="text-primary" style="cursor: default;">---</span>
        </li>
    </ul>
</div>
