{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier offre{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fs-3 mb-1">Modifier l'offre</h1>
            <p class="mb-0 text-secondary">Mise a jour de l'offre #{{ offre.id }}.</p>
        </div>
    </div>
    <div class="card">
        <div class="card-body p-4">
            {% include 'admin/offre_emploi/_form.html.twig' with {form: form, button_label: 'Mettre a jour'} %}
        </div>
    </div>
</div>
{% endblock %}
