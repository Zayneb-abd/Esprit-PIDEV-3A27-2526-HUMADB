{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier la Participation{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="mb-4">
                <a href="{{ path('admin_participation_index') }}" class="btn btn-outline-secondary">
                    <i class="ti ti-arrow-left"></i> Retour à la liste
                </a>
            </div>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
            {% for message in app.flashes('danger') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Modifier la Participation</h5>
                </div>
                <div class="card-body">
                    <form method="POST">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="text-muted mb-3">Informations Employé</h6>
                                <div class="mb-3">
                                    <label class="form-label">Nom complet:</label>
                                    <input type="text" class="form-control" value="{{ participation.user.nom }} {{ participation.user.prenom }}" readonly>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Email:</label>
                                    <input type="email" class="form-control" value="{{ participation.user.email }}" readonly>
                                </div>
                                {% if participation.user.telephone %}
                                <div class="mb-3">
                                    <label class="form-label">Téléphone:</label>
                                    <input type="tel" class="form-control" value="{{ participation.user.telephone }}" readonly>
                                </div>
                                {% endif %}
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted mb-3">Informations Formation</h6>
                                <div class="mb-3">
                                    <label class="form-label">Sujet:</label>
                                    <input type="text" class="form-control" value="{{ participation.formation.sujet }}" readonly>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Formateur:</label>
                                    <input type="text" class="form-control" value="{{ participation.formation.formateur }}" readonly>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Type:</label>
                                    <input type="text" class="form-control" value="{{ participation.formation.type }}" readonly>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Date Début:</label>
                                    <input type="text" class="form-control" value="{{ participation.formation.dateDebut ? participation.formation.dateDebut|date('d/m/Y H:i') : '' }}" readonly>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Durée:</label>
                                    <input type="text" class="form-control" value="{{ participation.formation.duree }} jours" readonly>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Localisation:</label>
                                    <input type="text" class="form-control" value="{{ participation.formation.localisation }}" readonly>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-md-6">
                                <h6 class="text-muted mb-3">Informations Participation</h6>
                                <div class="mb-3">
                                    <label class="form-label">Date Demande:</label>
                                    <input type="text" class="form-control" value="{{ participation.dateInscription ? participation.dateInscription|date('d/m/Y H:i') : '' }}" readonly>
                                </div>
                                <div class="mb-3">
                                    <label for="statut" class="form-label">Statut:</label>
                                    <select id="statut" name="statut" class="form-select">
                                        <option value="en attente" {% if participation.statut == 'en attente' %}selected{% endif %}>En attente</option>
                                        <option value="accepté" {% if participation.statut == 'accepté' %}selected{% endif %}>Accepté</option>
                                        <option value="refusé" {% if participation.statut == 'refusé' %}selected{% endif %}>Refusé</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">
                                    <i class="ti ti-device-floppy"></i> Enregistrer les modifications
                                </button>
                                <a href="{{ path('admin_participation_index') }}" class="btn btn-outline-secondary">
                                    <i class="ti ti-x"></i> Annuler
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
