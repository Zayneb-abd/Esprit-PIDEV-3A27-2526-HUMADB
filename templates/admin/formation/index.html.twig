{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Formations{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <div class="mb-4 d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="fs-3 mb-1">Gestion des Formations</h1>
                    <p class="mb-0">Gérez les formations et sessions de formation</p>
                </div>
                <div>
                    <a href="{{ path('admin_formation_new') }}" class="btn btn-primary">
                        <i class="ti ti-plus"></i> Nouvelle formation
                    </a>
                </div>
            </div>

            <div class="card p-3 mb-4">
                <form action="{{ path('admin_formation') }}" method="GET" class="row g-3">
                    <div class="col-md-8">
                        <input type="text" name="q" class="form-control" placeholder="Rechercher par sujet, formateur, type ou localisation..." value="{{ query }}">
                    </div>
                    <div class="col-md-2">
                        <select name="sort" class="form-select">
                            <option value="">Trier par...</option>
                            <option value="sujet" {% if sort == 'sujet' %}selected{% endif %}>Sujet</option>
                            <option value="formateur" {% if sort == 'formateur' %}selected{% endif %}>Formateur</option>
                            <option value="type" {% if sort == 'type' %}selected{% endif %}>Type</option>
                            <option value="date_debut" {% if sort == 'date_debut' %}selected{% endif %}>Date début</option>
                            <option value="duree" {% if sort == 'duree' %}selected{% endif %}>Durée</option>
                            <option value="localisation" {% if sort == 'localisation' %}selected{% endif %}>Localisation</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-secondary w-100">
                            <i class="ti ti-search"></i> Rechercher
                        </button>
                    </div>
                </form>
            </div>

            <div class="card table-responsive">
                <table class="table mb-0 text-nowrap table-hover">
                    <thead class="table-light border-light">
                        <tr>
                            <th>Sujet</th>
                            <th>Formateur</th>
                            <th>Type</th>
                            <th>Date début</th>
                            <th>Durée (jours)</th>
                            <th>Localisation</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for formation in formations %}
                            <tr class="align-middle">
                                <td>{{ formation.sujet|default('-') }}</td>
                                <td>{{ formation.formateur|default('-') }}</td>
                                <td>
                                    {% if formation.type %}
                                        {{ formation.type|replace({'_': ' '})|title }}
                                    {% else %}
                                        <em>-</em>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if formation.dateDebut %}
                                        {{ formation.dateDebut|date('d/m/Y') }}
                                    {% else %}
                                        <em>-</em>
                                    {% endif %}
                                </td>
                                <td>{{ formation.duree|default('-') }}</td>
                                <td>{{ formation.localisation|default('-') }}</td>
                                <td>
                                    <a href="{{ path('admin_formation_edit', {id: formation.id}) }}" class="btn btn-sm btn-info" title="Modifier">
                                        <i class="ti ti-edit"></i>
                                    </a>
                                    <form action="{{ path('admin_formation_delete', {id: formation.id}) }}" method="POST" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette formation ?');">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <p class="text-muted mb-0">Aucune formation trouvée.</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
