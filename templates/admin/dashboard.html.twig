{% extends 'admin/base_admin.html.twig' %}

{% block title %}Dashboard Utilisateurs{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Tableau de bord</h4>
        <small class="text-muted">Vue d'ensemble des utilisateurs</small>
    </div>
    <a href="{{ path('admin_user_add') }}" class="btn btn-sm btn-primary">
        <i class="ti ti-plus me-1"></i> Nouvel utilisateur
    </a>
</div>

{# ── PARTICIPATION CHARTS ── #}
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Graphique en barres : nombre de participants par formation</h6>
            </div>
            <div class="card-body">
                <canvas id="participantsChart" height="100"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Graphique en camembert : répartition des résultats</h6>
            </div>
            <div class="card-body">
                <canvas id="resultsChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

{# ── STAT CARDS ── #}
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card-blue">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon"><i class="ti ti-users text-blue fs-5"></i></div>
                <div>
                    <p class="mb-0 small text-muted">Total utilisateurs</p>
                    <h3 class="mb-0 fw-bold">{{ total_users }}</h3>
                </div>
            </div>
        </div>
    </div>

    {% for role, count in count_by_role %}
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card-orange">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon"><i class="ti ti-shield text-orange fs-5"></i></div>
                <div>
                    <p class="mb-0 small text-muted">{{ role ?? 'Inconnu' }}</p>
                    <h3 class="mb-0 fw-bold">{{ count }}</h3>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

{# ── FEEDBACK STATS ── #}
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold"><i class="ti ti-message-2 me-2 text-primary"></i>Feedbacks — 7 derniers jours</h6>
                <a href="{{ path('admin_feedback_index') }}" class="btn btn-sm btn-outline-primary">Voir tout</a>
            </div>
            <div class="card-body">
                <canvas id="adminDashboardFeedbackLine" height="100"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-semibold"><i class="ti ti-chart-donut me-2 text-primary"></i>Feedbacks par statut</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="adminDashboardFeedbackStatus" style="max-height:220px;"></canvas>
            </div>
        </div>
    </div>
</div>

{# ── RECENT USERS ── #}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center py-3 px-4 border-bottom">
        <h6 class="mb-0 fw-semibold">Inscriptions récentes</h6>
        <a href="{{ path('admin_users') }}" class="btn btn-sm btn-outline-primary">Voir tous <i class="ti ti-arrow-right ms-1"></i></a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-4">Utilisateur</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Réputation</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in recent_users %}
                    <tr>
                        <td class="px-4">
                            <div class="d-flex align-items-center gap-2">
                                {% if user.faceImage %}
                                    <img src="{{ asset('uploads/faces/' ~ user.faceImage) }}" class="avatar-sm rounded-circle" alt="">
                                {% else %}
                                    <div class="avatar-sm rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold" style="width:32px;height:32px;font-size:13px;">
                                        {{ user.prenom|first|upper }}
                                    </div>
                                {% endif %}
                                <strong>{{ user.prenom }} {{ user.nom }}</strong>
                            </div>
                        </td>
                        <td class="text-muted small">{{ user.email }}</td>
                        <td>
                            <span class="badge bg-secondary">{{ user.role ?? 'USER' }}</span>
                        </td>
                        <td>
                            {% set badge = user.reputationBadge %}
                            <span class="badge {% if badge == 'Gold' %}bg-warning text-dark{% elseif badge == 'Silver' %}bg-secondary{% else %}bg-danger{% endif %}">
                                {{ badge }} ({{ user.reputationScore }})
                            </span>
                        </td>
                        <td>
                            <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-xs btn-outline-secondary btn-sm">
                                <i class="ti ti-edit"></i>
                            </a>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="5" class="text-center text-muted py-4">Aucun utilisateur.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# ── QUICK LINKS ── #}
<div class="row g-3 mt-2">
    <div class="col-md-4">
        <a href="{{ path('admin_users') }}" class="card text-decoration-none h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="ti ti-users fs-3 text-primary"></i>
                <div><strong>Gérer les utilisateurs</strong><br><small class="text-muted">Ajouter, modifier, supprimer</small></div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="{{ path('admin_logs') }}" class="card text-decoration-none h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="ti ti-list-details fs-3 text-info"></i>
                <div><strong>Journal d'activité</strong><br><small class="text-muted">Voir tous les logs</small></div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="{{ path('admin_inventory') }}" class="card text-decoration-none h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="ti ti-briefcase fs-3 text-warning"></i>
                <div><strong>Recrutement</strong><br><small class="text-muted">Offres et candidatures</small></div>
            </div>
        </a>
    </div>
</div>

{# ── Chart.js SCRIPTS ── #}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// Bar Chart: Participants per Training
const participantsCtx = document.getElementById('participantsChart').getContext('2d');
const participantsChart = new Chart(participantsCtx, {
    type: 'bar',
    data: {
        labels: {{ trainingLabels|json_encode|raw }},
        datasets: [{
            label: 'Nombre de participants',
            data: {{ participantsPerTraining|json_encode|raw }},
            backgroundColor: 'rgba(54, 162, 235, 0.8)',
            borderColor: 'rgba(54, 162, 235, 1)',
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
            y: {
                beginAtZero: true,
                ticks: {
                    stepSize: 1
                }
            }
        },
        plugins: {
            legend: {
                display: true,
                position: 'top'
            }
        }
    }
});

// Pie Chart: Results Distribution
const resultsCtx = document.getElementById('resultsChart').getContext('2d');
const resultsChart = new Chart(resultsCtx, {
    type: 'pie',
    data: {
        labels: ['Validé', 'Non validé', 'En cours'],
        datasets: [{
            data: [
                {{ resultsDistribution.validé }},
                {{ resultsDistribution['non validé'] }},
                {{ resultsDistribution['en cours'] }}
            ],
            backgroundColor: [
                'rgba(40, 167, 69, 0.8)',
                'rgba(239, 68, 68, 0.8)',
                'rgba(59, 130, 246, 0.8)'
            ],
            borderColor: [
                'rgba(40, 167, 69, 1)',
                'rgba(239, 68, 68, 1)',
                'rgba(59, 130, 246, 1)'
            ],
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                position: 'bottom'
            },
            tooltip: {
                callbacks: {
                    label: function(context) {
                        const label = context.label || '';
                        const value = context.parsed || 0;
                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                        const percentage = ((value / total) * 100).toFixed(1);
                        return label + ': ' + value + ' (' + percentage + '%)';
                    }
                }
            }
        }
    }
});
</script>

{% endblock %}

{% block js %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function () {
    const labels = {{ feedback_timeline_labels|json_encode|raw }};
    const data = {{ feedback_timeline_data|json_encode|raw }};
    const byStatus = {{ feedback_by_status|json_encode|raw }};
    const stLabels = Object.keys(byStatus).map(s => ({ 'nouveau': 'Nouveau', 'en_cours': 'En cours', 'traite': 'Traité', 'rejete': 'Rejeté' }[s] || s));
    const stData = Object.values(byStatus);

    if (document.getElementById('adminDashboardFeedbackLine')) {
        new Chart(document.getElementById('adminDashboardFeedbackLine'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Feedbacks',
                    data: data,
                    borderColor: 'rgb(99, 102, 241)',
                    backgroundColor: 'rgba(99, 102, 241, 0.12)',
                    fill: true,
                    tension: 0.35
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    }
    if (document.getElementById('adminDashboardFeedbackStatus')) {
        new Chart(document.getElementById('adminDashboardFeedbackStatus'), {
            type: 'doughnut',
            data: {
                labels: stLabels.length ? stLabels : ['—'],
                datasets: [{
                    data: stData.length ? stData : [0],
                    backgroundColor: ['#ef4444', '#f59e0b', '#22c55e', '#64748b', '#6366f1']
                }]
            },
            options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
        });
    }
})();
</script>
{% endblock %}
