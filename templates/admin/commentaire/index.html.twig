{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des commentaires{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fs-4 fw-bold mb-1">Gestion des commentaires</h1>
            <p class="text-muted mb-0">Liste de tous les commentaires.</p>
        </div>
        <a href="{{ path('admin_publication') }}" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i> Retour aux publications
        </a>
    </div>

    <div class="row g-4">
        {% for commentaire in commentaires %}
            <div class="col-12 col-md-6">
                <div class="card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                            <div>
                                <span class="badge text-bg-light border">#{{ commentaire.id }}</span>
                                <h5 class="mb-2 mt-2">{{ commentaire.user ? commentaire.user.prenom ~ ' ' ~ commentaire.user.nom : 'Utilisateur inconnu' }}</h5>
                                <p class="text-muted mb-0">{{ commentaire.dateCommentaire ? commentaire.dateCommentaire|date('d/m/Y H:i') : '-' }}</p>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="{{ path('admin_commentaire_edit', { id: commentaire.id }) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                                <form method="post" action="{{ path('admin_commentaire_delete', { id: commentaire.id }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_commentaire_' ~ commentaire.id) }}">
                                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Supprimer ce commentaire ?');">Supprimer</button>
                                </form>
                            </div>
                        </div>

                        <hr>
                        <p class="mb-0">{{ commentaire.contenu }}</p>
                        
                        {% if commentaire.publication %}
                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="ti ti-message-circle me-1"></i>
                                    Sur la publication #{{ commentaire.publication.id }}
                                </small>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center py-5 text-muted">
                        Aucun commentaire.
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
