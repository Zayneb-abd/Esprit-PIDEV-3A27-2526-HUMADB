{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouveau commentaire{% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="fs-4 fw-bold mb-1">Nouveau commentaire</h1>
    <p class="text-muted">Publication cible: #{{ publication ? publication.id : 'N/A' }}</p>
    <div class="card">
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" name="publication_id" value="{{ publication ? publication.id : '' }}">
                <div class="mb-3">
                    <label for="contenu" class="form-label">Contenu</label>
                    <textarea name="contenu" id="contenu" class="form-control" rows="4" required></textarea>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary">Ajouter</button>
                    <a class="btn btn-outline-secondary" href="{{ path('admin_publication') }}">Retour</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
