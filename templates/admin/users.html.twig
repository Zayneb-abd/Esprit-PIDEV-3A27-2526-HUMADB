{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Utilisateurs</h4>
        <small class="text-muted">{{ total }} utilisateur(s) trouvé(s)</small>
    </div>
    <a href="{{ path('admin_user_add') }}" class="btn btn-sm btn-primary">
        <i class="ti ti-plus me-1"></i> Ajouter
    </a>
</div>

{# ── SEARCH ── #}
<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" action="{{ path('admin_users') }}" class="d-flex gap-2">
            <input type="text" name="q" value="{{ search }}" class="form-control form-control-sm" placeholder="Rechercher par nom, prénom ou email…" id="searchInput">
            <select name="role" class="form-select form-select-sm" style="max-width: 180px;">
                <option value="">Tous les rôles</option>
                <option value="ADMIN_RH" {% if role == 'ADMIN_RH' %}selected{% endif %}>ADMIN_RH</option>
                <option value="MANAGER" {% if role == 'MANAGER' %}selected{% endif %}>MANAGER</option>
                <option value="EMPLOYE" {% if role == 'EMPLOYE' %}selected{% endif %}>EMPLOYE</option>
                <option value="CANDIDAT" {% if role == 'CANDIDAT' %}selected{% endif %}>CANDIDAT</option>
            </select>
            <button type="submit" class="btn btn-sm btn-primary"><i class="ti ti-search"></i></button>
            {% if search or role %}
                <a href="{{ path('admin_users') }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
            {% endif %}
        </form>
    </div>
</div>

{# ── TABLE ── #}
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-4">#</th>
                        <th>Utilisateur</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Réputation</th>
                        <th>Naissance</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td class="px-4 text-muted small">{{ user.id }}</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                {% if user.faceImage %}
                                    <img src="{{ asset('uploads/faces/' ~ user.faceImage) }}" class="rounded-circle" style="width:32px;height:32px;object-fit:cover;" alt="">
                                {% else %}
                                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold" style="width:32px;height:32px;font-size:12px;flex-shrink:0;">
                                        {{ user.prenom|first|upper }}
                                    </div>
                                {% endif %}
                                <span>{{ user.prenom }} {{ user.nom }}</span>
                            </div>
                        </td>
                        <td class="text-muted small">{{ user.email }}</td>
                        <td>
                            <span class="badge {% if user.role == 'ADMIN_RH' %}bg-danger{% elseif user.role == 'MANAGER' %}bg-warning text-dark{% elseif user.role == 'EMPLOYE' %}bg-success{% else %}bg-secondary{% endif %}">
                                {{ user.role ?? 'USER' }}
                            </span>
                        </td>
                        <td>
                            {% set badge = user.reputationBadge %}
                            <span class="badge {% if badge == 'Gold' %}bg-warning text-dark{% elseif badge == 'Silver' %}bg-secondary{% else %}bg-danger{% endif %}">
                                {{ badge }} · {{ user.reputationScore }}
                            </span>
                        </td>
                        <td class="text-muted small">
                            {{ user.dateNaissance ? user.dateNaissance|date('d/m/Y') : '—' }}
                        </td>
                        <td class="text-end pe-4">
                            <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-sm btn-outline-secondary me-1" title="Modifier">
                                <i class="ti ti-edit"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger" title="Supprimer"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal{{ user.id }}">
                                <i class="ti ti-trash"></i>
                            </button>
                        </td>
                    </tr>

                    {# ── DELETE MODAL ── #}
                    <div class="modal fade" id="deleteModal{{ user.id }}" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Confirmer la suppression</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    Êtes-vous sûr de vouloir supprimer <strong>{{ user.prenom }} {{ user.nom }}</strong> ?<br>
                                    <small class="text-muted">Cette action est irréversible.</small>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                    <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">Aucun utilisateur trouvé.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# ── PAGINATION ── #}
    {% if pages > 1 %}
    <div class="card-footer d-flex justify-content-between align-items-center">
        <small class="text-muted">Page {{ page }} / {{ pages }}</small>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                {% if page > 1 %}
                    <li class="page-item">
                        <a class="page-link" href="{{ path('admin_users', {page: page - 1, q: search, role: role}) }}">‹ Précédent</a>
                    </li>
                {% endif %}
                {% for p in 1..pages %}
                    <li class="page-item {% if p == page %}active{% endif %}">
                        <a class="page-link" href="{{ path('admin_users', {page: p, q: search, role: role}) }}">{{ p }}</a>
                    </li>
                {% endfor %}
                {% if page < pages %}
                    <li class="page-item">
                        <a class="page-link" href="{{ path('admin_users', {page: page + 1, q: search, role: role}) }}">Suivant ›</a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    </div>
    {% endif %}
</div>
{% endblock %}
