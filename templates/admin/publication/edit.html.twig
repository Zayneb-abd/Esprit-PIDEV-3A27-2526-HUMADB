{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier publication{% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="fs-4 fw-bold mb-3">Modifier publication #{{ publication.id }}</h1>
        <div class="card">
            <div class="card-body p-4">
                <form method="post">
                    <div class="mb-3">
                        <label for="contenu" class="form-label">Contenu</label>
                    <textarea name="contenu" id="contenu" class="form-control js-rich-editor" rows="5" required>{{ publication.contenu }}</textarea>
                    </div>
                <div class="mb-3">
                    <label for="type" class="form-label">Type</label>
                    <input type="text" name="type" id="type" class="form-control" value="{{ publication.type }}" placeholder="Ex: General, Annonce, etc.">
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary">Mettre a jour</button>
                    <a class="btn btn-outline-secondary" href="{{ path('admin_publication') }}">Retour</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block js %}
{{ parent() }}
{% include 'components/rich_text_editor.html.twig' %}
{% endblock %}
