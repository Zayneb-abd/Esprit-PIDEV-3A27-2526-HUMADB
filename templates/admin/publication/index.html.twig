{% extends 'admin/base_admin.html.twig' %}

{% block title %}Publications{% endblock %}

{% block body %}
<style>
.facebook-post {
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    margin-bottom: 20px;
}
.facebook-post-header {
    display: flex;
    align-items: center;
    padding: 12px 15px;
    border-bottom: 1px solid #e9ebee;
}
.facebook-post-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    margin-right: 12px;
}
.facebook-post-info {
    flex: 1;
}
.facebook-post-author {
    font-weight: 600;
    color: #1c1e21;
    margin: 0;
    font-size: 15px;
}
.facebook-post-meta {
    color: #65676b;
    font-size: 13px;
    margin: 0;
}
.facebook-post-actions {
    display: flex;
    gap: 8px;
}
.facebook-post-content {
    padding: 15px;
    color: #1c1e21;
    font-size: 15px;
    line-height: 1.5;
}
.facebook-post-media {
    padding: 0 15px;
}
.facebook-post-media img {
    max-width: 100%;
    max-height: 300px;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    margin-bottom: 8px;
    display: block;
    margin-left: auto;
    margin-right: auto;
}
.facebook-post-media video {
    max-width: 100%;
    max-height: 300px;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    margin-bottom: 8px;
    display: block;
    margin-left: auto;
    margin-right: auto;
}
.facebook-post-footer {
    padding: 12px 15px;
    border-top: 1px solid #e9ebee;
}
.facebook-post-stats {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    font-size: 13px;
    color: #65676b;
}
.facebook-post-buttons {
    display: flex;
    justify-content: space-around;
    padding-top: 8px;
    border-top: 1px solid #e9ebee;
}
.facebook-post-button {
    background: none;
    border: none;
    color: #65676b;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 12px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: background-color 0.2s;
}
.facebook-post-button:hover {
    background-color: #f0f2f5;
}
.facebook-comments {
    padding: 0 15px 15px;
}
.facebook-comment {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
    padding: 8px;
    background: #f0f2f5;
    border-radius: 8px;
}
.facebook-comment-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 12px;
    font-weight: bold;
    flex-shrink: 0;
}
.facebook-comment-content {
    flex: 1;
}
.facebook-comment-author {
    font-weight: 600;
    color: #1c1e21;
    font-size: 13px;
    margin-bottom: 2px;
}
.facebook-comment-text {
    color: #1c1e21;
    font-size: 14px;
    margin-bottom: 4px;
}
.facebook-comment-meta {
    color: #65676b;
    font-size: 12px;
}
.facebook-comment-actions {
    display: flex;
    gap: 8px;
    margin-top: 4px;
}
.facebook-comment-action {
    background: none;
    border: none;
    color: #65676b;
    font-size: 12px;
    cursor: pointer;
    padding: 0;
}
.facebook-comment-action:hover {
    text-decoration: underline;
}
</style>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fs-4 fw-bold mb-1">Publications et commentaires</h1>
            <p class="text-muted mb-0">CRUD complet des publications dans l'espace admin.</p>
        </div>
        <a href="{{ path('admin_publication_new') }}" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i> Nouvelle publication
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body p-3">
            <form method="get" action="{{ path('admin_publication') }}" class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label for="publication-search-admin" class="form-label mb-1">Recherche</label>
                    <input
                        id="publication-search-admin"
                        type="search"
                        name="q"
                        value="{{ search|default('') }}"
                        class="form-control"
                        placeholder="Rechercher par contenu, type, auteur ou email..."
                    >
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">Rechercher</button>
                    <a href="{{ path('admin_publication') }}" class="btn btn-outline-secondary w-100">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
        {% for publication in publications %}
            <div class="col-12">
                <div class="facebook-post">
                    <div class="facebook-post-header">
                        <div class="facebook-post-avatar">
                            {{ publication.user ? publication.user.prenom|first ~ publication.user.nom|first : 'U' }}
                        </div>
                        <div class="facebook-post-info">
                            <div class="facebook-post-author">
                                {{ publication.user ? publication.user.prenom ~ ' ' ~ publication.user.nom : 'Utilisateur inconnu' }}
                            </div>
                            <div class="facebook-post-meta">
                                {{ publication.datePublication ? publication.datePublication|date('d M Y à H:i') : '-' }}
                                {% if publication.type %}
                                    <span class="badge text-bg-primary ms-2">{{ publication.type }}</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="facebook-post-actions">
                            <a href="{{ path('admin_commentaire_new', { publication: publication.id }) }}" class="btn btn-sm btn-light">Ajouter commentaire</a>
                            <a href="{{ path('admin_publication_edit', { id: publication.id }) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                            <form method="post" action="{{ path('admin_publication_delete', { id: publication.id }) }}" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_publication_' ~ publication.id) }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button>
                            </form>
                        </div>
                    </div>
                    
                    <div class="facebook-post-content">
                        {{ publication.contenu|nl2br }}
                    </div>

                    {% if publication.publicationMedias|length > 0 %}
                        <div class="facebook-post-media">
                            {% for media in publication.publicationMedias %}
                                {% if media.type == 'image' %}
                                    <img src="{{ asset(media.path) }}" alt="Image de la publication">
                                {% elseif media.type == 'video' %}
                                    <video controls>
                                        <source src="{{ asset(media.path) }}" type="video/mp4">
                                        <source src="{{ asset(media.path) }}" type="video/webm">
                                        <source src="{{ asset(media.path) }}" type="video/ogg">
                                        Votre navigateur ne supporte pas les vidéos.
                                    </video>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}

                    <div class="facebook-post-footer">
                        <div class="facebook-post-stats">
                            <span>{{ publication.commentaires|length }} commentaire{% if publication.commentaires|length > 1 %}s{% endif %}</span>
                            <span>{{ publication.publicationMedias|length }} média{% if publication.publicationMedias|length > 1 %}s{% endif %}</span>
                        </div>
                    </div>

                    {% if publication.commentaires|length > 0 %}
                        <div class="facebook-comments">
                            {% for commentaire in publication.commentaires %}
                                <div class="facebook-comment">
                                    <div class="facebook-comment-avatar">
                                        {{ commentaire.user ? commentaire.user.prenom|first ~ commentaire.user.nom|first : 'U' }}
                                    </div>
                                    <div class="facebook-comment-content">
                                        <div class="facebook-comment-author">
                                            {{ commentaire.user ? commentaire.user.prenom ~ ' ' ~ commentaire.user.nom : 'Utilisateur inconnu' }}
                                        </div>
                                        <div class="facebook-comment-text">
                                            {{ commentaire.contenu }}
                                        </div>
                                        <div class="facebook-comment-meta">
                                            {{ commentaire.dateCommentaire ? commentaire.dateCommentaire|date('d M Y à H:i') : '-' }}
                                        </div>
                                        <div class="facebook-comment-actions">
                                            <button class="facebook-comment-action">Like</button>
                                            <button class="facebook-comment-action">Répondre</button>
                                            <a href="{{ path('admin_commentaire_edit', { id: commentaire.id }) }}" class="facebook-comment-action">Modifier</a>
                                            <form method="post" action="{{ path('admin_commentaire_delete', { id: commentaire.id }) }}" style="display: inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_commentaire_' ~ commentaire.id) }}">
                                                <button class="facebook-comment-action" type="submit">Supprimer</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center py-5 text-muted">
                        Aucune publication.
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
