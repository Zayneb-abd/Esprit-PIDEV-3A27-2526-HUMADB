{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier le Feedback{% endblock %}

{% block body %}
<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fs-4 fw-bold mb-1">Détails du Feedback #{{ feedback.id }}</h1>
        <p class="text-muted mb-0">Modifier le statut ou la catégorie.</p>
    </div>
    <a href="{{ path('admin_feedback_index') }}" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-2"></i>Retour à la liste
    </a>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-semibold text-primary"><i class="ti ti-message-2 me-2"></i>Contenu du Feedback</h5>
            </div>
            <div class="card-body p-4">
                <blockquote class="blockquote px-3 py-2 border-start border-4 border-primary bg-light rounded" style="font-size:15px;">
                    <p class="mb-0">{{ feedback.contenu | nl2br }}</p>
                </blockquote>
                
                <hr>
                <div class="row mt-3 text-muted small">
                    <div class="col-6">
                        <strong><i class="ti ti-calendar me-1"></i>Date :</strong> {{ feedback.dateEnvoi ? feedback.dateEnvoi|date('d/m/Y') : 'N/A' }}
                    </div>
                    <div class="col-6 text-end">
                        <strong><i class="ti ti-user me-1"></i>Auteur :</strong> 
                        {% if feedback.estAnonyme %}
                            Anonyme
                        {% else %}
                            Employé #{{ feedback.employeId }}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-5 mt-4 mt-lg-0">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-semibold"><i class="ti ti-settings me-2"></i>Gestion</h5>
            </div>
            <div class="card-body p-4">
                {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_label(form.status, "Statut", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.status, {'attr': {'class': 'form-select shadow-sm'}}) }}
                    </div>
                    <div class="mb-4">
                        {{ form_label(form.category, "Catégorie", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.category, {'attr': {'class': 'form-select shadow-sm'}}) }}
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary shadow-sm">
                            <i class="ti ti-device-floppy me-2"></i>Enregistrer les modifications
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
