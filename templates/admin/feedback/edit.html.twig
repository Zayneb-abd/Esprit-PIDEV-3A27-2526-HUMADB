{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier le Feedback{% endblock %}

{% block body %}
<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fs-4 fw-bold mb-1">Détails du Feedback #{{ feedback.id }}</h1>
        <p class="text-muted mb-0">Modifier le statut, la priorité ou la catégorie.</p>
    </div>
    <a href="{{ path('admin_feedback_index') }}" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-2"></i>Retour à la liste
    </a>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-semibold text-primary"><i class="ti ti-message-2 me-2"></i>Contenu du Feedback</h5>
            </div>
            <div class="card-body p-4">
                <blockquote class="blockquote px-3 py-2 border-start border-4 border-primary bg-light rounded" style="font-size:15px;">
                    <p class="mb-0">{{ feedback.contenu | nl2br }}</p>
                </blockquote>
                
                <hr>
                <div class="row mt-3 text-muted small">
                    <div class="col-6">
                        <strong><i class="ti ti-calendar me-1"></i>Date :</strong> {{ feedback.dateEnvoi ? feedback.dateEnvoi|date('d/m/Y') : 'N/A' }}
                    </div>
                    <div class="col-6 text-end">
                        <strong><i class="ti ti-user me-1"></i>Auteur :</strong> 
                        {% if feedback.estAnonyme %}
                            Anonyme
                        {% else %}
                            Employé #{{ feedback.employeId }}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-semibold text-primary"><i class="ti ti-mood-smile me-2"></i>Analyse du sentiment</h5>
            </div>
            <div class="card-body p-4">
                {% if sentiment.success %}
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                        <div>
                            <div class="fw-bold fs-5">{{ sentiment.label }}</div>
                            <div class="text-muted small">{{ sentiment.description }}</div>
                        </div>
                        <span class="badge bg-primary bg-opacity-10 text-primary">
                            Confiance {{ sentiment.confidence }}%
                        </span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 rounded-3 bg-light h-100">
                                <div class="text-muted small mb-1">Score tag</div>
                                <div class="fw-semibold">{{ sentiment.score_tag }}</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 rounded-3 bg-light h-100">
                                <div class="text-muted small mb-1">Subjectivité</div>
                                <div class="fw-semibold">{{ sentiment.subjectivity }}</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 rounded-3 bg-light h-100">
                                <div class="text-muted small mb-1">Ironie</div>
                                <div class="fw-semibold">{{ sentiment.irony }}</div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="alert alert-warning mb-0">
                        {{ sentiment.error|default('MeaningCloud n\'est pas disponible pour le moment.') }}
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-semibold text-primary"><i class="ti ti-robot me-2"></i>Réponse AI</h5>
                <div class="d-flex gap-2">
                    <form method="post" action="{{ path('admin_feedback_auto_response', {'id': feedback.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('feedback_ai_' ~ feedback.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            <i class="ti ti-sparkles me-1"></i>Générer
                        </button>
                    </form>
                </div>
            </div>
            <div class="card-body p-4">
                <form method="post" action="{{ path('admin_feedback_send_reply', {'id': feedback.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('feedback_send_' ~ feedback.id) }}">
                    <label class="form-label fw-bold">Réponse à envoyer à l'employé</label>
                    <textarea
                        name="reply_text"
                        class="form-control"
                        rows="7"
                        placeholder="Rédigez ou générez une réponse, puis envoyez-la..."
                    >{{ feedback.autoResponse }}</textarea>

                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <div class="text-muted small">
                            {% if feedback.autoResponseGeneratedAt %}
                                Générée le {{ feedback.autoResponseGeneratedAt|date('d/m/Y H:i') }}
                            {% endif %}
                            {% if feedback.autoResponseSentAt %}
                                {% if feedback.autoResponseGeneratedAt %} • {% endif %}
                                Envoyée le {{ feedback.autoResponseSentAt|date('d/m/Y H:i') }}
                            {% endif %}
                        </div>
                        <button type="submit" class="btn btn-sm btn-success">
                            <i class="ti ti-send me-1"></i>Envoyer à l'employé
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-5 mt-4 mt-lg-0">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-semibold"><i class="ti ti-settings me-2"></i>Gestion</h5>
            </div>
            <div class="card-body p-4">
                {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_label(form.status, "Statut", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.status, {'attr': {'class': 'form-select shadow-sm'}}) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.priority, "Priorité", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.priority, {'attr': {'class': 'form-select shadow-sm'}}) }}
                    </div>
                    <div class="mb-4">
                        {{ form_label(form.category, "Catégorie", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.category, {'attr': {'class': 'form-select shadow-sm'}}) }}
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary shadow-sm">
                            <i class="ti ti-device-floppy me-2"></i>Enregistrer les modifications
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
