{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Feedbacks{% endblock %}

{% block body %}
<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="fs-4 fw-bold mb-1">Feedbacks</h1>
        <p class="text-muted mb-0">Priorités, statistiques et traitement des retours.</p>
    </div>
    <div class="text-muted small">
        Total : <strong>{{ feedback_stats.total }}</strong>
    </div>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
{% endfor %}

{# ── Statistics charts ── #}
<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom-0">
                <h6 class="mb-0 fw-semibold"><i class="ti ti-chart-line me-2 text-primary"></i>Feedbacks reçus (7 derniers jours)</h6>
            </div>
            <div class="card-body pt-0">
                <canvas id="feedbackTimelineChart" height="110"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom-0">
                <h6 class="mb-0 fw-semibold"><i class="ti ti-chart-pie me-2 text-primary"></i>Répartition</h6>
            </div>
            <div class="card-body pt-0">
                <canvas id="feedbackDoughnutChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-2 small fw-semibold">Par statut</div>
            <div class="card-body py-3">
                <canvas id="feedbackStatusChart" height="160"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-2 small fw-semibold">Par priorité</div>
            <div class="card-body py-3">
                <canvas id="feedbackPriorityChart" height="160"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mt-3 mb-3">
    <div class="card-body py-3">
        <form method="get" action="{{ path('admin_feedback_index') }}" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small text-muted mb-1">Recherche</label>
                <input
                    type="text"
                    name="q"
                    value="{{ query|default('') }}"
                    class="form-control form-control-sm"
                    placeholder="Message, catégorie, statut, priorité, ID employé..."
                >
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Priorité</label>
                <select name="priority" class="form-select form-select-sm">
                    <option value="">Toutes</option>
                    <option value="urgente" {{ priority_filter == 'urgente' ? 'selected' }}>Urgente</option>
                    <option value="haute" {{ priority_filter == 'haute' ? 'selected' }}>Haute</option>
                    <option value="normal" {{ priority_filter == 'normal' ? 'selected' }}>Normale</option>
                    <option value="bas" {{ priority_filter == 'bas' ? 'selected' }}>Basse</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary"><i class="ti ti-search"></i> Filtrer</button>
                {% if query or priority_filter %}
                    <a href="{{ path('admin_feedback_index') }}" class="btn btn-sm btn-outline-secondary">Réinitialiser</a>
                {% endif %}
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm mt-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3">ID</th>
                        <th class="py-3">Priorité</th>
                        <th class="py-3">Message</th>
                        <th class="py-3">Catégorie</th>
                        <th class="py-3">Statut</th>
                        <th class="py-3">Auteur</th>
                        <th class="py-3">Date</th>
                        <th class="text-end px-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for feedback in feedbacks %}
                    <tr>
                        <td class="px-4 text-muted fw-medium">#{{ feedback.id }}</td>
                        <td>
                            {% set p = feedback.priority %}
                            {% if p == 'urgente' %}
                                <span class="badge bg-danger">Urgente</span>
                            {% elseif p == 'haute' %}
                                <span class="badge bg-warning text-dark">Haute</span>
                            {% elseif p == 'bas' %}
                                <span class="badge bg-secondary">Basse</span>
                            {% else %}
                                <span class="badge bg-info text-dark">Normale</span>
                            {% endif %}
                        </td>
                        <td>
                            <div style="max-width:280px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                {{ feedback.contenu }}
                            </div>
                        </td>
                        <td>{{ feedback.category }}</td>
                        <td>
                            {% if feedback.status == 'nouveau' %}
                                <span class="badge bg-danger">Nouveau</span>
                            {% elseif feedback.status == 'en_cours' %}
                                <span class="badge bg-warning text-dark">En cours</span>
                            {% elseif feedback.status == 'traite' %}
                                <span class="badge bg-success">Traité</span>
                            {% else %}
                                <span class="badge bg-secondary">{{ feedback.status }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if feedback.estAnonyme %}
                                <span class="text-muted fst-italic">Anonyme</span>
                            {% else %}
                                Employé #{{ feedback.employeId }}
                            {% endif %}
                        </td>
                        <td class="text-muted">{{ feedback.dateEnvoi ? feedback.dateEnvoi|date('Y-m-d') : '' }}</td>
                        <td class="text-end px-4">
                            <a href="{{ path('admin_feedback_edit', {'id': feedback.id}) }}" class="btn btn-sm btn-light text-primary me-2 shadow-sm rounded-3">
                                <i class="ti ti-edit"></i>
                            </a>
                            <form method="post" action="{{ path('admin_feedback_delete', {'id': feedback.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce feedback ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ feedback.id) }}">
                                <button class="btn btn-sm btn-light text-danger shadow-sm rounded-3">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">Aucun feedback trouvé.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block js %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function () {
    const timelineLabels = {{ feedback_stats.timeline_labels|json_encode|raw }};
    const timelineData = {{ feedback_stats.timeline_data|json_encode|raw }};
    const byCategory = {{ feedback_stats.by_category|json_encode|raw }};
    const byStatus = {{ feedback_stats.by_status|json_encode|raw }};
    const byPriority = {{ feedback_stats.by_priority|json_encode|raw }};

    const catLabels = Object.keys(byCategory);
    const catData = Object.values(byCategory);

    new Chart(document.getElementById('feedbackTimelineChart'), {
        type: 'line',
        data: {
            labels: timelineLabels,
            datasets: [{
                label: 'Feedbacks',
                data: timelineData,
                borderColor: 'rgb(99, 102, 241)',
                backgroundColor: 'rgba(99, 102, 241, 0.15)',
                fill: true,
                tension: 0.3
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

    new Chart(document.getElementById('feedbackDoughnutChart'), {
        type: 'doughnut',
        data: {
            labels: catLabels.length ? catLabels : ['—'],
            datasets: [{
                data: catData.length ? catData : [0],
                backgroundColor: ['#6366f1', '#f59e0b', '#10b981', '#ef4444', '#8b5cf6', '#64748b']
            }]
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
    });

    const statusKeys = Object.keys(byStatus);
    new Chart(document.getElementById('feedbackStatusChart'), {
        type: 'bar',
        data: {
            labels: statusKeys.length ? statusKeys.map(s => ({ 'nouveau': 'Nouveau', 'en_cours': 'En cours', 'traite': 'Traité', 'rejete': 'Rejeté' }[s] || s)) : ['Aucune donnée'],
            datasets: [{
                label: 'Nombre',
                data: statusKeys.length ? Object.values(byStatus) : [0],
                backgroundColor: ['#ef4444', '#f59e0b', '#22c55e', '#64748b']
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

    const prioOrder = ['urgente', 'haute', 'normal', 'bas'];
    const prioLabels = { 'urgente': 'Urgente', 'haute': 'Haute', 'normal': 'Normale', 'bas': 'Basse' };
    const prioKeys = prioOrder;
    const prioData = prioKeys.map(k => byPriority[k] || 0);
    new Chart(document.getElementById('feedbackPriorityChart'), {
        type: 'bar',
        data: {
            labels: prioKeys.map(k => prioLabels[k] || k),
            datasets: [{
                label: 'Nombre',
                data: prioData,
                backgroundColor: ['#dc2626', '#f59e0b', '#0ea5e9', '#64748b']
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });
})();
</script>
{% endblock %}
