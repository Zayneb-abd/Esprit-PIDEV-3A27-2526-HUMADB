<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}HUMA - Agence de Gestion des Ressources Humaines{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-teal: #1a5f5f;
            --primary-teal-light: #2d7a7a;
            --accent-cyan: #4ecdc4;
            --dark-bg: #1a3a3a;
            --text-dark: #2c3e50;
            --text-light: #5a6c7d;
            --bg-light: #f8f9fa;
            --white: #ffffff;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Open Sans', sans-serif;
            color: var(--text-dark);
            line-height: 1.6;
        }
        
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
        }
        
        /* Modern Navbar */
        .navbar-huma {
            background: var(--white);
            box-shadow: 0 2px 20px rgba(0,0,0,0.08);
            padding: 0.8rem 0;
        }
        
        .navbar-huma .navbar-brand {
            font-family: 'Montserrat', sans-serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary-teal) !important;
            letter-spacing: -0.5px;
        }
        
        .navbar-huma .navbar-brand span {
            color: var(--accent-cyan);
        }
        
        .navbar-huma .nav-link {
            color: var(--text-dark) !important;
            font-weight: 500;
            font-size: 0.95rem;
            padding: 0.5rem 1rem !important;
            transition: color 0.3s ease;
        }
        
        .navbar-huma .nav-link:hover {
            color: var(--primary-teal) !important;
        }
        
        .navbar-huma .btn-primary {
            background: var(--primary-teal);
            border: none;
            padding: 0.5rem 1.5rem;
            font-weight: 500;
            border-radius: 25px;
        }
        
        .navbar-huma .btn-primary:hover {
            background: var(--primary-teal-light);
        }
        
        /* Hero Section */
        .hero-section {
            background: linear-gradient(135deg, var(--dark-bg) 0%, var(--primary-teal) 100%);
            min-height: 80vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        
        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="0.5"/></svg>');
            background-size: 200px;
            opacity: 0.5;
        }
        
        .hero-content {
            position: relative;
            z-index: 2;
        }
        
        .hero-title {
            font-size: 3.2rem;
            font-weight: 700;
            color: var(--white);
            line-height: 1.2;
            margin-bottom: 1.5rem;
        }
        
        .hero-subtitle {
            font-size: 1.3rem;
            color: rgba(255,255,255,0.9);
            margin-bottom: 2rem;
            font-weight: 400;
        }
        
        .hero-image {
            position: relative;
            z-index: 2;
        }
        
        .hero-image img {
            border-radius: 20px;
            box-shadow: 0 30px 60px rgba(0,0,0,0.3);
        }
        
        .btn-hero {
            background: var(--white);
            color: var(--primary-teal);
            padding: 1rem 2.5rem;
            font-weight: 600;
            border-radius: 30px;
            border: none;
            transition: all 0.3s ease;
        }
        
        .btn-hero:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }
        
        /* Section Headers */
        .section-title {
            font-size: 2.5rem;
            color: var(--text-dark);
            margin-bottom: 1rem;
            position: relative;
        }
        
        .section-title::after {
            content: '';
            display: block;
            width: 60px;
            height: 4px;
            background: var(--accent-cyan);
            margin: 1rem auto;
            border-radius: 2px;
        }
        
        .section-title-left::after {
            margin: 1rem 0;
        }
        
        /* Agency Section */
        .agency-section {
            padding: 5rem 0;
            background: var(--bg-light);
        }
        
        .agency-subtitle {
            font-size: 1.1rem;
            color: var(--primary-teal);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 1rem;
        }
        
        /* Approach Section */
        .approach-section {
            padding: 5rem 0;
        }
        
        .approach-card {
            background: var(--white);
            padding: 2.5rem;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.08);
        }
        
        .approach-image {
            position: relative;
        }
        
        .approach-image img {
            border-radius: 50%;
            width: 200px;
            height: 200px;
            object-fit: cover;
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }
        
        .approach-image-small {
            position: absolute;
            bottom: -20px;
            right: -20px;
        }
        
        .approach-image-small img {
            width: 120px;
            height: 120px;
            border: 5px solid var(--white);
        }
        
        /* RH Needs Section */
        .needs-section {
            padding: 5rem 0;
            background: var(--dark-bg);
            color: var(--white);
        }
        
        .needs-section .section-title {
            color: var(--white);
        }
        
        .needs-section .section-title::after {
            background: var(--accent-cyan);
        }
        
        .need-card {
            padding: 2rem;
            border-left: 4px solid var(--accent-cyan);
            background: rgba(255,255,255,0.05);
            border-radius: 0 10px 10px 0;
            margin-bottom: 1.5rem;
            transition: all 0.3s ease;
        }
        
        .need-card:hover {
            background: rgba(255,255,255,0.1);
            transform: translateX(10px);
        }
        
        .need-card h4 {
            color: var(--accent-cyan);
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
        }
        
        .need-card p {
            color: rgba(255,255,255,0.8);
            font-size: 0.95rem;
            margin-bottom: 0;
        }
        
        /* Opportunities Section */
        .opportunities-section {
            padding: 5rem 0;
            background: var(--bg-light);
        }
        
        .opportunity-card {
            position: relative;
            border-radius: 15px;
            overflow: hidden;
            height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: var(--white);
        }
        
        .opportunity-card img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
        }
        
        .opportunity-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(26, 95, 95, 0.7);
            z-index: 2;
        }
        
        .opportunity-card.yellow::before {
            background: rgba(255, 193, 7, 0.8);
        }
        
        .opportunity-content {
            position: relative;
            z-index: 3;
        }
        
        .opportunity-content h3 {
            font-size: 1.8rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        
        /* Modern Footer */
        .footer-huma {
            background: var(--dark-bg);
            color: var(--white);
            padding: 4rem 0 2rem;
        }
        
        .footer-brand {
            font-family: 'Montserrat', sans-serif;
            font-size: 2rem;
            font-weight: 700;
            color: var(--white);
            margin-bottom: 1rem;
        }
        
        .footer-brand span {
            color: var(--accent-cyan);
        }
        
        .footer-link {
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            transition: color 0.3s ease;
        }
        
        .footer-link:hover {
            color: var(--accent-cyan);
        }
        
        .social-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            transition: all 0.3s ease;
        }
        
        .social-icon:hover {
            background: var(--accent-cyan);
            color: var(--dark-bg);
        }
        
        /* HUMA Brand Highlight */
        .huma-brand {
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            background: linear-gradient(135deg, var(--primary-teal) 0%, var(--accent-cyan) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        /* Page Header */
        .page-header {
            background: linear-gradient(135deg, var(--dark-bg) 0%, var(--primary-teal) 100%);
            padding: 4rem 0;
            margin-bottom: 0;
        }
        
        .page-header .page-title {
            color: var(--white);
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }
        
        .page-header .breadcrumb {
            background: none;
            padding: 0;
            margin: 0;
        }
        
        .page-header .breadcrumb-item a {
            color: rgba(255,255,255,0.8);
            text-decoration: none;
        }
        
        .page-header .breadcrumb-item a:hover {
            color: var(--accent-cyan);
        }
        
        .page-header .breadcrumb-item.active {
            color: var(--accent-cyan);
        }
        
        .page-header .breadcrumb-item + .breadcrumb-item::before {
            color: rgba(255,255,255,0.5);
        }
        
        /* Team Cards */
        .team-card {
            background: var(--white);
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
        }
        
        .team-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.15);
        }
        
        .team-card .team-image {
            height: 250px;
            overflow: hidden;
        }
        
        .team-card .team-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }
        
        .team-card:hover .team-image img {
            transform: scale(1.05);
        }
        
        .team-card .team-content {
            padding: 1.5rem;
            text-align: center;
        }
        
        .team-card .team-content h4 {
            color: var(--primary-teal);
            font-size: 1.2rem;
            margin-bottom: 0.3rem;
        }
        
        @media (max-width: 768px) {
            .hero-title {
                font-size: 2rem;
            }
            
            .section-title {
                font-size: 1.8rem;
            }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <!-- Modern Navbar -->
    <nav class="navbar navbar-expand-lg navbar-huma sticky-top">
        <div class="container">
            <a class="navbar-brand" href="{{ path('client_home') }}">
                <span class="huma-brand">HUMA</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('client_home') }}">Nous découvrir</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('client_services') }}">Nos solutions RH</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('client_about') }}">Opportunités</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('contact_index') }}">Contact</a>
                    </li>
                </ul>
                <ul class="navbar-nav align-items-center">
                    {% if app.user %}
                        <li class="nav-item dropdown">
                            <a class="nav-link d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown">
                                {% if app.user.faceImage %}
                                    <img src="{{ asset('uploads/faces/' ~ app.user.faceImage) }}" alt="Avatar" class="rounded-circle" width="35" height="35" style="object-fit: cover;">
                                {% else %}
                                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center" style="width: 35px; height: 35px; font-size: 14px; background: var(--primary-teal) !important;">
                                        {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                                    </div>
                                {% endif %}
                                <span>{{ app.user.prenom }} {{ app.user.nom }}</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li><a class="dropdown-item" href="{{ path('admin_dashboard') }}"><i class="bi bi-shield-lock me-2"></i>Administration</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                {% elseif is_granted('ROLE_EMPLOYE') %}
                                    <li><a class="dropdown-item" href="{{ path('employ_dashboard') }}"><i class="bi bi-briefcase me-2"></i>Espace Employé</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                {% elseif is_granted('ROLE_CANDIDAT') or is_granted('ROLE_CONDIDAT') %}
                                    <li><a class="dropdown-item" href="{{ path('candidat_dashboard') }}"><i class="bi bi-person-badge me-2"></i>Espace Candidat</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                {% endif %}
                                <li><a class="dropdown-item" href="{{ path('user_profile') }}"><i class="bi bi-person me-2"></i>Mon profil</a></li>
                                <li><a class="dropdown-item" href="{{ path('user_edit_profile') }}"><i class="bi bi-pencil me-2"></i>Modifier le profil</a></li>
                                <li><a class="dropdown-item" href="{{ path('user_change_password') }}"><i class="bi bi-lock me-2"></i>Changer mot de passe</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="btn btn-primary" href="{{ path('app_login') }}">Connexion</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    {% block body %}{% endblock %}

    <!-- Modern Footer -->
    <footer class="footer-huma">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4">
                    <div class="footer-brand"><span>HUMA</span></div>
                    <p class="text-white-50">Votre partenaire en gestion des ressources humaines. Nous accompagnons les entreprises dans leur développement et la valorisation de leur capital humain.</p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="social-icon"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-facebook"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h5 class="text-white mb-3">Navigation</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="{{ path('client_home') }}" class="footer-link">Accueil</a></li>
                        <li class="mb-2"><a href="{{ path('client_about') }}" class="footer-link">À propos</a></li>
                        <li class="mb-2"><a href="{{ path('client_services') }}" class="footer-link">Services</a></li>
                        <li class="mb-2"><a href="{{ path('contact_index') }}" class="footer-link">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h5 class="text-white mb-3">Services</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="footer-link">Recrutement</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">Formation</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">Conseil RH</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">Gestion des talents</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 mb-4">
                    <h5 class="text-white mb-3">Contact</h5>
                    <p class="text-white-50 mb-2"><i class="bi bi-geo-alt me-2"></i>Tunis, Tunisie</p>
                    <p class="text-white-50 mb-2"><i class="bi bi-envelope me-2"></i>contact@huma.tn</p>
                    <p class="text-white-50 mb-2"><i class="bi bi-telephone me-2"></i>+216 71 000 000</p>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center text-white-50">
                <p class="mb-0">&copy; {{ "now"|date("Y") }} <span class="huma-brand">HUMA</span>. Tous droits réservés.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
        
    {% block javascripts %}{% endblock %}
</body>
</html>
